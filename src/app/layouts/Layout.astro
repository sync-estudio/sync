---
import "@app/styles/global.css";
import Navbar from "@shared/components/layout/navbar.astro";
import Footer from "@shared/components/layout/footer.astro";

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
}

const {
	title = "SYNC Estudio — Software e IA a medida para empresas en operación",
	description = "Construimos software e IA a medida para empresas en operación: rediseñamos flujos, formamos al equipo y mantenemos las herramientas de nuestro lado.",
	ogTitle = "SYNC Estudio — Software e IA a medida para empresas en operación",
	ogDescription = "Software e IA a medida para empresas en operación. Construimos las herramientas, rediseñamos los flujos y formamos a tu equipo — con mantenimiento continuo de nuestro lado.",
} = Astro.props;

const googleFontsUrl =
	"https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=IBM+Plex+Serif:ital,wght@1,700&display=swap";

const siteUrl = "https://syncestudio.com";
const canonicalHref = new URL(Astro.url.pathname, siteUrl).href;
const ogImageAbs = new URL("/share_image.webp", siteUrl).href;
const logoAbs = new URL("/sync_logo.svg", siteUrl).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta name="description" content={description} />
		<meta name="theme-color" content="#10b981" />
		<meta name="robots" content="index,follow" />
		<link rel="canonical" href={canonicalHref} />

		<!-- Preconnect for Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href={googleFontsUrl} />
		<link rel="stylesheet" href={googleFontsUrl} media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href={googleFontsUrl} />
		</noscript>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="SYNC Estudio" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:locale" content="es" />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:image" content={ogImageAbs} />
		<meta property="og:image:type" content="image/webp" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="SYNC Estudio — Software e IA a medida para empresas en operación" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImageAbs} />
		<meta name="twitter:image:alt" content="SYNC Estudio — Software e IA a medida para empresas en operación" />

		<!-- Structured Data: Organization -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "SYNC Estudio",
			"url": siteUrl,
			"logo": logoAbs,
			"description": "Software e IA a medida para empresas en operación. Construimos las herramientas, rediseñamos los flujos y formamos al equipo, con mantenimiento continuo.",
			"sameAs": [
				"https://www.instagram.com/sync.estudio/",
				"https://www.linkedin.com/company/syncestudio/"
			]
		})} />
		<style is:global>
			:root {
				--anchor-scroll-offset: 0px;
				--anchor-scroll-gap: 16px;
			}

			:where(#inicio, #soluciones, #nosotros, #proyectos, #metodologia, #preguntas, #contacto) {
				scroll-margin-top: calc(var(--anchor-scroll-offset) + var(--anchor-scroll-gap));
			}
		</style>
	</head>

	<body
		class="min-h-screen font-[Manrope] text-zinc-800 relative"
	>
		<Navbar />

		<main>
			<slot />
		</main>

		<Footer />
		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const anchorGap = 16;
				const sectionPath = "/";
				const SCROLL_THRESHOLD = 8;
				let resizeFrame = 0;
				let lastViewportWidth = window.innerWidth;

				const getNavbarBottom = () => {
					const navbar = document.querySelector("[data-site-nav]");
					if (!(navbar instanceof HTMLElement)) return 0;
					return Math.max(0, Math.ceil(navbar.getBoundingClientRect().bottom));
				};

				const getNavbarBottomFor = (targetScrollY: number) => {
					const navbar = document.querySelector("[data-site-nav]");
					const pill = navbar?.querySelector<HTMLElement>("[data-nav-pill]");
					if (!(navbar instanceof HTMLElement) || !(pill instanceof HTMLElement)) {
						return getNavbarBottom();
					}

					const willBeScrolled = targetScrollY > SCROLL_THRESHOLD;
					const isScrolledNow = navbar.classList.contains("is-scrolled");

					if (willBeScrolled === isScrolledNow) {
						return getNavbarBottom();
					}

					const prevNavTransition = navbar.style.transition;
					const prevPillTransition = pill.style.transition;
					navbar.style.transition = "none";
					pill.style.transition = "none";
					navbar.classList.toggle("is-scrolled", willBeScrolled);
					pill.classList.toggle("is-scrolled", willBeScrolled);
					void navbar.offsetHeight;

					const bottom = Math.max(0, Math.ceil(navbar.getBoundingClientRect().bottom));

					navbar.classList.toggle("is-scrolled", isScrolledNow);
					pill.classList.toggle("is-scrolled", isScrolledNow);
					void navbar.offsetHeight;
					navbar.style.transition = prevNavTransition;
					pill.style.transition = prevPillTransition;

					return bottom;
				};

				const syncAnchorOffset = () => {
					document.documentElement.style.setProperty("--anchor-scroll-offset", `${getNavbarBottom()}px`);
				};

				const getSectionElement = (hash: string) => {
					const sectionId = decodeURIComponent(hash.replace(/^#/, ""));

					if (!sectionId) {
						return null;
					}

					return document.getElementById(sectionId);
				};

				const computeTargetY = (targetElement: HTMLElement) => {
					const absoluteTop = window.scrollY + targetElement.getBoundingClientRect().top;
					const provisionalY = Math.max(0, absoluteTop - getNavbarBottom() - anchorGap);
					const navBottomAtTarget = getNavbarBottomFor(provisionalY);
					return Math.max(0, absoluteTop - navBottomAtTarget - anchorGap);
				};

				const scrollToHash = (hash: string, behavior: ScrollBehavior) => {
					const targetElement = getSectionElement(hash);

					if (!targetElement) {
						return;
					}

					window.scrollTo({
						top: computeTargetY(targetElement),
						behavior
					});
				};

				syncAnchorOffset();

				document.addEventListener("click", (event) => {
					const target = event.target;
					const link = target instanceof Element ? target.closest('a[href^="/#"]') : null;

					if (!(link instanceof HTMLAnchorElement)) {
						return;
					}

					const url = new URL(link.href, window.location.origin);

					if (url.pathname !== sectionPath || window.location.pathname !== sectionPath) {
						return;
					}

					const targetElement = getSectionElement(url.hash);

					if (!targetElement) {
						return;
					}

					event.preventDefault();
					syncAnchorOffset();
					scrollToHash(url.hash, "smooth");

					if (window.location.hash !== url.hash) {
						history.pushState(null, "", `${sectionPath}${url.hash}`);
					}
				});

				window.addEventListener("load", () => {
					syncAnchorOffset();

					if (window.location.pathname === sectionPath && window.location.hash) {
						scrollToHash(window.location.hash, "auto");
					}
				});

				window.addEventListener("hashchange", () => {
					if (window.location.pathname !== sectionPath || !window.location.hash) {
						return;
					}

					syncAnchorOffset();
					scrollToHash(window.location.hash, "auto");
				});

				window.addEventListener("resize", () => {
					cancelAnimationFrame(resizeFrame);
					resizeFrame = window.requestAnimationFrame(() => {
						syncAnchorOffset();
						const currentViewportWidth = window.innerWidth;
						const didViewportWidthChange = currentViewportWidth !== lastViewportWidth;
						lastViewportWidth = currentViewportWidth;

						if (didViewportWidthChange && window.location.pathname === sectionPath && window.location.hash) {
							scrollToHash(window.location.hash, "auto");
						}
					});
				});
			});
		</script>
	</body>
</html>
