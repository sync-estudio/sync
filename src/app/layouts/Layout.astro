---
import "@app/styles/global.css";
import Navbar from "@shared/components/layout/navbar.astro";
import Footer from "@shared/components/layout/footer.astro";
import {
	SITE_URL,
	organizationSchema,
	websiteSchema,
	localBusinessSchema,
	type JsonLd,
} from "@shared/seo/schema";
import {
	getLang,
	otherLang,
	useTranslations,
	routes,
	type Lang,
	type RouteKey,
} from "@i18n/utils";

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	ogDescription?: string;
	/** Page-specific JSON-LD nodes appended to the default graph. */
	schema?: JsonLd[];
	/** Static route key — derives both-locale paths for hreflang + switcher. */
	routeKey?: RouteKey;
	/** Explicit per-locale paths (for data-driven dynamic routes). */
	alternates?: Record<Lang, string>;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const {
	title = t("meta.title"),
	description = t("meta.description"),
	ogTitle = t("meta.ogTitle"),
	ogDescription = t("meta.ogDescription"),
	schema = [],
	routeKey,
	alternates,
} = Astro.props;

const googleFontsUrl =
	"https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap";

const siteUrl = SITE_URL;

// Both-locale paths for this page: explicit > route key > current path (fallback).
const localePaths: Record<Lang, string> =
	alternates ??
	(routeKey
		? { es: routes[routeKey].es, en: routes[routeKey].en }
		: { es: Astro.url.pathname, en: Astro.url.pathname });

const esHref = new URL(localePaths.es, siteUrl).href;
const enHref = new URL(localePaths.en, siteUrl).href;
const canonicalHref = lang === "es" ? esHref : enHref;
const switchHref = localePaths[otherLang(lang)];

const htmlLang = lang === "es" ? "es-MX" : "en-US";
const ogLocale = lang === "es" ? "es_MX" : "en_US";
const ogLocaleAlt = lang === "es" ? "en_US" : "es_MX";

const homePath = routes.home[lang];
const ogImageAbs = new URL("/share_image.webp", siteUrl).href;
const ogImageAlt = t("meta.ogImageAlt");

// Default graph on every page + any page-specific nodes (Service, FAQPage,
// BreadcrumbList, Article) passed via the `schema` prop.
const jsonLdGraph: JsonLd[] = [
	organizationSchema(lang),
	websiteSchema(lang),
	localBusinessSchema(lang),
	...schema,
];
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta name="description" content={description} />
		<meta name="theme-color" content="#10b981" />
		<meta name="robots" content="index,follow" />
		<link rel="canonical" href={canonicalHref} />
		<link rel="alternate" hreflang="es-MX" href={esHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="x-default" href={esHref} />

		<!-- Preconnect for Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href={googleFontsUrl} />
		<link rel="stylesheet" href={googleFontsUrl} media="print" onload="this.media='all'" />
		<noscript>
			<link rel="stylesheet" href={googleFontsUrl} />
		</noscript>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="SYNC Estudio" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlt} />
		<meta property="og:url" content={canonicalHref} />
		<meta property="og:image" content={ogImageAbs} />
		<meta property="og:image:type" content="image/webp" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImageAbs} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Structured Data: Organization + WebSite + LocalBusiness + page nodes -->
		{jsonLdGraph.map((node) => (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
		))}
		<!-- Meta Pixel Code -->
		<script is:inline>
			!function(f,b,e,v,n,t,s)
			{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
			n.callMethod.apply(n,arguments):n.queue.push(arguments)};
			if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
			n.queue=[];t=b.createElement(e);t.async=!0;
			t.src=v;s=b.getElementsByTagName(e)[0];
			s.parentNode.insertBefore(t,s)}(window, document,'script',
			'https://connect.facebook.net/en_US/fbevents.js');
			fbq('init', '1312288423886650');
			fbq('track', 'PageView');
		</script>
		<noscript
			><img
				height="1"
				width="1"
				style="display:none"
				src="https://www.facebook.com/tr?id=1312288423886650&ev=PageView&noscript=1"
			/></noscript
		>
		<!-- End Meta Pixel Code -->

		<!-- Mark JS early so [data-reveal] elements can hide pre-paint without
		     risking invisible content when JS is disabled. -->
		<script is:inline>
			document.documentElement.classList.add("js-reveal");
		</script>
		<style is:global>
			:root {
				--anchor-scroll-offset: 0px;
				--anchor-scroll-gap: 16px;
			}

			:where(#inicio, #soluciones, #nosotros, #proyectos, #metodologia, #preguntas, #contacto) {
				scroll-margin-top: calc(var(--anchor-scroll-offset) + var(--anchor-scroll-gap));
			}

			/* Scroll-reveal: hidden only when JS ran early. Reduced motion and
			   no-JS both leave content fully visible. */
			.js-reveal [data-reveal] {
				opacity: 0;
			}

			@media (prefers-reduced-motion: reduce) {
				.js-reveal [data-reveal] {
					opacity: 1;
				}
			}
		</style>
	</head>

	<body
		class="min-h-screen font-[Manrope] text-zinc-800 relative"
		data-home-path={homePath}
	>
		<Navbar lang={lang} switchHref={switchHref} />

		<main>
			<slot />
		</main>

		<Footer lang={lang} />
		<script>
			// Site-wide scroll-reveal. Any element with [data-reveal] fades +
			// rises into place once it enters the viewport. Optional
			// data-reveal-delay (ms) staggers siblings. Reduced motion shows
			// everything immediately (CSS already keeps it visible).
			(() => {
				const reduce = window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				).matches;
				const els = Array.from(
					document.querySelectorAll<HTMLElement>("[data-reveal]"),
				);
				if (!els.length) return;

				if (reduce || !("IntersectionObserver" in window)) {
					els.forEach((el) => (el.style.opacity = "1"));
					return;
				}

				const io = new IntersectionObserver(
					(entries, obs) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							const el = entry.target as HTMLElement;
							obs.unobserve(el);
							const delay = Number(el.dataset.revealDelay ?? 0);
							el.animate(
								[
									{ opacity: 0, transform: "translateY(20px)" },
									{ opacity: 1, transform: "translateY(0)" },
								],
								{
									duration: 600,
									easing: "cubic-bezier(0.22, 1, 0.36, 1)",
									delay,
									fill: "both",
								},
							);
						});
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
				);

				els.forEach((el) => io.observe(el));
			})();
		</script>
		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const anchorGap = 16;
				const stripSlash = (p: string) => (p.length > 1 ? p.replace(/\/$/, "") : p);
				const sectionPath = stripSlash(document.body.dataset.homePath || "/");
				const SCROLL_THRESHOLD = 8;
				const atSectionPath = () => stripSlash(window.location.pathname) === sectionPath;
				let resizeFrame = 0;
				let lastViewportWidth = window.innerWidth;

				const getNavbarBottom = () => {
					const navbar = document.querySelector("[data-site-nav]");
					if (!(navbar instanceof HTMLElement)) return 0;
					return Math.max(0, Math.ceil(navbar.getBoundingClientRect().bottom));
				};

				const getNavbarBottomFor = (targetScrollY: number) => {
					const navbar = document.querySelector("[data-site-nav]");
					const pill = navbar?.querySelector<HTMLElement>("[data-nav-pill]");
					if (!(navbar instanceof HTMLElement) || !(pill instanceof HTMLElement)) {
						return getNavbarBottom();
					}

					const willBeScrolled = targetScrollY > SCROLL_THRESHOLD;
					const isScrolledNow = navbar.classList.contains("is-scrolled");

					if (willBeScrolled === isScrolledNow) {
						return getNavbarBottom();
					}

					const prevNavTransition = navbar.style.transition;
					const prevPillTransition = pill.style.transition;
					navbar.style.transition = "none";
					pill.style.transition = "none";
					navbar.classList.toggle("is-scrolled", willBeScrolled);
					pill.classList.toggle("is-scrolled", willBeScrolled);
					void navbar.offsetHeight;

					const bottom = Math.max(0, Math.ceil(navbar.getBoundingClientRect().bottom));

					navbar.classList.toggle("is-scrolled", isScrolledNow);
					pill.classList.toggle("is-scrolled", isScrolledNow);
					void navbar.offsetHeight;
					navbar.style.transition = prevNavTransition;
					pill.style.transition = prevPillTransition;

					return bottom;
				};

				const syncAnchorOffset = () => {
					document.documentElement.style.setProperty("--anchor-scroll-offset", `${getNavbarBottom()}px`);
				};

				const getSectionElement = (hash: string) => {
					const sectionId = decodeURIComponent(hash.replace(/^#/, ""));

					if (!sectionId) {
						return null;
					}

					return document.getElementById(sectionId);
				};

				const getScrollAnchor = (section: HTMLElement) => {
					const content = section.firstElementChild;
					return content instanceof HTMLElement ? content : section;
				};

				const isCenteredSection = (section: HTMLElement) => {
					const style = getComputedStyle(section);
					return style.display.includes("flex") && style.alignItems === "center";
				};

				const computeTargetY = (targetElement: HTMLElement) => {
					const anchorElement = getScrollAnchor(targetElement);
					const rect = anchorElement.getBoundingClientRect();
					const absoluteTop = window.scrollY + rect.top;
					const provisionalY = Math.max(0, absoluteTop - getNavbarBottom() - anchorGap);
					const navBottomAtTarget = getNavbarBottomFor(provisionalY);

					// Full-height centered sections (flex + items-center) keep their
					// content centered in the viewport below the navbar when it fits.
					// Everything else lands its content top just below the navbar.
					const viewportBelowNav = window.innerHeight - navBottomAtTarget;
					const slack = viewportBelowNav - rect.height;
					const offset =
						isCenteredSection(targetElement) && slack > anchorGap * 2
							? slack / 2
							: anchorGap;

					return Math.max(0, absoluteTop - navBottomAtTarget - offset);
				};

				const scrollToHash = (hash: string, behavior: ScrollBehavior) => {
					const targetElement = getSectionElement(hash);

					if (!targetElement) {
						return;
					}

					window.scrollTo({
						top: computeTargetY(targetElement),
						behavior
					});
				};

				syncAnchorOffset();

				document.addEventListener("click", (event) => {
					const target = event.target;
					const link = target instanceof Element ? target.closest('a[href*="#"]') : null;

					if (!(link instanceof HTMLAnchorElement)) {
						return;
					}

					const url = new URL(link.href, window.location.origin);

					if (!url.hash || stripSlash(url.pathname) !== sectionPath || !atSectionPath()) {
						return;
					}

					const targetElement = getSectionElement(url.hash);

					if (!targetElement) {
						return;
					}

					event.preventDefault();
					syncAnchorOffset();
					scrollToHash(url.hash, "smooth");

					if (window.location.hash !== url.hash) {
						history.pushState(null, "", `${sectionPath}${url.hash}`);
					}
				});

				window.addEventListener("load", () => {
					syncAnchorOffset();

					if (atSectionPath() && window.location.hash) {
						scrollToHash(window.location.hash, "auto");
					}
				});

				window.addEventListener("hashchange", () => {
					if (!atSectionPath() || !window.location.hash) {
						return;
					}

					syncAnchorOffset();
					scrollToHash(window.location.hash, "auto");
				});

				window.addEventListener("resize", () => {
					cancelAnimationFrame(resizeFrame);
					resizeFrame = window.requestAnimationFrame(() => {
						syncAnchorOffset();
						const currentViewportWidth = window.innerWidth;
						const didViewportWidthChange = currentViewportWidth !== lastViewportWidth;
						lastViewportWidth = currentViewportWidth;

						if (didViewportWidthChange && atSectionPath() && window.location.hash) {
							scrollToHash(window.location.hash, "auto");
						}
					});
				});
			});
		</script>
	</body>
</html>
