---
export interface Props {
    image: string;
    style?: string;
    data: {
        name: string;
        year: string;
        development?: boolean;
    };
}

const { image, style = "", data } = Astro.props;
---

<article class="text-start w-full sm:w-auto flex flex-col gap-4">
    <div
        class="bg-emerald-50 w-full sm:w-80 md:w-90 h-64 sm:h-80 md:h-90 rounded-2xl flex justify-center items-center overflow-hidden"
    >
        <img
            class={`${style} max-w-full max-h-full object-contain`}
            src={image}
            alt={`${data.name} (${data.year})`}
        />
    </div>
    <div>
        <h4 class="font-semibold text-base md:text-lg">{data.name}</h4>
        <p class="text-sm md:text-base text-zinc-500">{data.year}</p>
        <span class="italic text-xs md:text-sm text-zinc-400 font-light"
            >{data.development ? "(En desarrollo)" : ""}</span
        >
    </div>
</article>
