---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";

// Copy — voz "del lado nuestro". Editar libremente.
type Step = {
    id: string;
    title: string;
    desc: string;
    surface: string;
    text: string;
    muted: string;
    cta?: boolean;
};

const steps: Step[] = [
    {
        id: "platforms",
        title: "Software a medida",
        desc: "Sistemas internos que se ajustan a cómo ya trabajas, no al revés. Tu equipo los opera; el mantenimiento queda de nuestro lado.",
        surface: "bg-white",
        text: "text-zinc-900",
        muted: "text-zinc-600",
    },
    {
        id: "ai",
        title: "Agentes de IA",
        desc: "Le quitamos a tu equipo el trabajo repetitivo. Hacen la tarea, te avisan cuando algo necesita tu decisión, y siempre ves qué están haciendo y por qué.",
        surface: "bg-zinc-900",
        text: "text-white",
        muted: "text-zinc-300",
    },
    {
        id: "mvp",
        title: "MVP",
        desc: "Construimos lo justo para salir al mundo y aprender de gente real. Sin gastar de más: validamos rápido y, desde ahí, crecemos contigo.",
        surface: "bg-white",
        text: "text-zinc-900",
        muted: "text-zinc-600",
        cta: true,
    },
];
---

<section id="servicios" data-offer class="relative">
    {
        steps.map((step) => (
            <section
                data-offer-panel
                class={`offer-panel relative h-[100dvh] w-full overflow-hidden flex items-center ${step.surface} ${step.text}`}
            >
                <div class="container mx-auto w-full relative z-10">
                    <div class={`max-w-3xl ${step.id === "ai" ? "ml-auto text-right" : ""}`}>
                        {step.id === "platforms" && (
                            <span class={`block mb-6 md:mb-8 text-sm md:text-base ${step.muted}`}>
                                ¿Qué podemos construir?
                            </span>
                        )}
                        <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight leading-[1.05]">
                            {step.title}
                        </h2>
                        <p class={`mt-5 md:mt-6 text-lg md:text-xl leading-relaxed ${step.muted}`}>
                            {step.desc}
                        </p>
                        {step.cta && (
                            <div class="mt-8 md:mt-10">
                                <Button link="/contacto">Solicitar diagnóstico</Button>
                            </div>
                        )}
                    </div>
                </div>
            </section>
        ))
    }
</section>

<style>
    /* Stabilize text during pin: promote each panel to its own GPU layer so
       antialiasing doesn't re-rasterize (the "tilt"/shimmer) as ScrollTrigger
       toggles position:fixed. */
    .offer-panel {
        transform: translateZ(0);
        backface-visibility: hidden;
        -webkit-font-smoothing: antialiased;
    }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function init() {
        const section = document.querySelector<HTMLElement>("[data-offer]");
        if (!section) return;
        const panels = gsap.utils.toArray<HTMLElement>(
            section.querySelectorAll("[data-offer-panel]"),
        );
        if (panels.length === 0) return;

        // Reduced motion: no pinning, panels just stack and scroll normally.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        // Layered pinning — each panel pins at the top so the next one
        // scrolls up and covers it. pinSpacing:false makes them stack
        // instead of pushing each other down. The LAST panel is left
        // unpinned so it scrolls out cleanly into the following section
        // instead of staying fixed and overlapping it.
        panels.slice(0, -1).forEach((panel) => {
            ScrollTrigger.create({
                trigger: panel,
                start: "top top",
                pin: true,
                pinSpacing: false,
                anticipatePin: 1,
                pinType: "transform",
            });
        });
    }

    init();
</script>
