---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";
import PhoneMockup from "./phone-mockup.astro";
import AgentTerminal from "./agent-terminal.astro";
import CustomPanel from "./custom-panel.astro";

// Placeholder copy + media — voz "del lado nuestro". Editar libremente.
// Para media real: reemplazar el gradiente por <img>/<video>.
type Step = {
    id: string;
    title: string;
    desc: string;
    surface: string;
    dots: string;
};

// Superficies como las cards de Soluciones: color sólido + patrón de puntos.
const steps: Step[] = [
    {
        id: "platforms",
        title: "Software a medida",
        desc: "Sistemas internos que se ajustan a cómo ya trabajas, no al revés. Tu equipo los opera; el mantenimiento queda de nuestro lado.",
        surface: "bg-[#defbed]",
        dots: "rgba(4,120,87,0.35)",
    },
    {
        id: "ai",
        title: "Agentes de IA",
        desc: "Le quitamos a tu equipo el trabajo repetitivo. Hacen la tarea, te avisan cuando algo necesita tu decisión, y siempre ves qué están haciendo y por qué.",
        surface: "bg-emerald-800",
        dots: "rgba(255,255,255,0.18)",
    },
    {
        id: "mvp",
        title: "MVP",
        desc: "Construimos lo justo para salir al mundo y aprender de gente real. Sin gastar de más: validamos rápido y, desde ahí, crecemos contigo.",
        surface: "bg-zinc-900",
        dots: "rgba(255,255,255,0.18)",
    },
];
---

<section
    id="servicios"
    data-offer-steps
    data-step-count={steps.length}
    class="relative"
    style={`height: ${steps.length * 100}dvh;`}
>
    <div
        data-offer-sticky
        class="sticky top-0 h-[100dvh] flex items-center overflow-hidden"
    >
        <div class="container mx-auto w-full">
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center"
            >
                {/* Media — pinned, crossfades per step */}
                <div class="relative aspect-square w-full max-w-xl rounded-3xl overflow-hidden">
                    {
                        steps.map((step, i) => (
                            <div
                                data-step-media
                                data-index={i}
                                data-active={i === 0 ? "true" : "false"}
                                style={`--offer-dot-color: ${step.dots};`}
                                class={`step-media absolute inset-0 ${step.surface}`}
                            >
                                <div class="offer-dots" aria-hidden="true" />
                                {step.id === "mvp" && (
                                    <div class="absolute inset-0 flex items-center justify-center p-6 md:p-10">
                                        <PhoneMockup />
                                    </div>
                                )}
                                {step.id === "ai" && (
                                    <div class="absolute inset-0 flex items-center justify-center p-6 md:p-10">
                                        <AgentTerminal />
                                    </div>
                                )}
                                {step.id === "platforms" && (
                                    <div class="absolute inset-0 flex items-center justify-center p-6 md:p-10">
                                        <CustomPanel />
                                    </div>
                                )}
                            </div>
                        ))
                    }
                </div>

                {/* Steps list — active goes solid, reveals desc */}
                <ol class="flex flex-col gap-5 md:gap-6">
                    {
                        steps.map((step, i) => (
                            <li>
                                <button
                                    type="button"
                                    data-step-item
                                    data-index={i}
                                    data-active={i === 0 ? "true" : "false"}
                                    class="step-item group block w-full text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 rounded-lg"
                                >
                                    <span class="step-title block text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight">
                                        {step.title}
                                    </span>
                                    <span class="step-desc block text-base md:text-lg text-zinc-600 leading-relaxed max-w-md">
                                        {step.desc}
                                    </span>
                                </button>
                            </li>
                        ))
                    }

                    <li class="mt-2">
                        <Button link="/contacto">Solicitar diagnóstico</Button>
                    </li>
                </ol>
            </div>
        </div>
    </div>
</section>

<style>
    .step-media {
        opacity: 0;
        transition:
            opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        transform: scale(1.04);
    }

    /* Patrón de puntos como las cards de Soluciones (estático, esquina inf-der). */
    .offer-dots {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image: radial-gradient(
            circle,
            var(--offer-dot-color) 1.2px,
            transparent 1.6px
        );
        background-size: 14px 14px;
        background-position: bottom right;
        mask-image: radial-gradient(
            circle 320px at 100% 100%,
            #000 0%,
            rgba(0, 0, 0, 0.2) 70%,
            transparent 100%
        );
        -webkit-mask-image: radial-gradient(
            circle 320px at 100% 100%,
            #000 0%,
            rgba(0, 0, 0, 0.2) 70%,
            transparent 100%
        );
    }
    .step-media[data-active="true"] {
        opacity: 1;
        transform: scale(1);
    }

    .step-title {
        color: rgb(212 212 216); /* zinc-300 */
        transition: color 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .step-item[data-active="true"] .step-title,
    .step-item:hover .step-title {
        color: rgb(24 24 27); /* zinc-900 */
    }

    .step-desc {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition:
            max-height 0.55s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.4s ease,
            margin-top 0.4s ease;
    }
    .step-item[data-active="true"] .step-desc {
        max-height: 14rem;
        opacity: 1;
        margin-top: 0.75rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .step-media {
            transition: opacity 0.01ms;
            transform: none;
        }
        .step-desc,
        .step-title {
            transition: none;
        }
    }
</style>

<script>
    const section = document.querySelector<HTMLElement>("[data-offer-steps]");

    if (section) {
        const count = Number(section.dataset.stepCount ?? "0");
        const sticky =
            section.querySelector<HTMLElement>("[data-offer-sticky]");
        const medias = Array.from(
            section.querySelectorAll<HTMLElement>("[data-step-media]"),
        );
        const items = Array.from(
            section.querySelectorAll<HTMLElement>("[data-step-item]"),
        );

        let active = -1;
        let ticking = false;

        const setActive = (index: number) => {
            const next = Math.max(0, Math.min(count - 1, index));
            if (next === active) return;
            active = next;
            medias.forEach((el) =>
                el.setAttribute(
                    "data-active",
                    el.dataset.index === String(next) ? "true" : "false",
                ),
            );
            items.forEach((el) =>
                el.setAttribute(
                    "data-active",
                    el.dataset.index === String(next) ? "true" : "false",
                ),
            );
        };

        // Use the pinned element's own height (layout-driven, dvh) instead of
        // window.innerHeight — mobile toolbar show/hide won't drift the math.
        const viewport = () => sticky?.offsetHeight ?? window.innerHeight;

        const update = () => {
            ticking = false;
            const rect = section.getBoundingClientRect();
            const scrollable = section.offsetHeight - viewport();
            if (scrollable <= 0) {
                setActive(0);
                return;
            }
            // progress 0→1 across the pinned scroll distance
            const progress = Math.min(
                1,
                Math.max(0, -rect.top / scrollable),
            );
            setActive(Math.floor(progress * count - 0.0001));
        };

        const onScroll = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();

        // Click a title → scroll to that step
        items.forEach((item) => {
            item.addEventListener("click", () => {
                const i = Number(item.dataset.index ?? "0");
                const scrollable = section.offsetHeight - viewport();
                const top =
                    section.offsetTop +
                    (scrollable * (i + 0.5)) / count;
                window.scrollTo({
                    top,
                    behavior: window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches
                        ? "auto"
                        : "smooth",
                });
            });
        });
    }
</script>

