---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";

// Copy — voz "del lado nuestro". Editar libremente.
type Step = {
    id: string;
    title: string;
    desc: string;
};

const steps: Step[] = [
    {
        id: "platforms",
        title: "Software a medida",
        desc: "Sistemas internos que se ajustan a cómo ya trabajas, no al revés. Tu equipo los opera; el mantenimiento queda de nuestro lado.",
    },
    {
        id: "ai",
        title: "Agentes de IA",
        desc: "Le quitamos a tu equipo el trabajo repetitivo. Hacen la tarea, te avisan cuando algo necesita tu decisión, y siempre ves qué están haciendo y por qué.",
    },
    {
        id: "mvp",
        title: "MVP",
        desc: "Construimos lo justo para salir al mundo y aprender de gente real. Sin gastar de más: validamos rápido y, desde ahí, crecemos contigo.",
    },
];
---

<section
    id="servicios"
    data-offer-steps
    data-step-count={steps.length}
    class="relative"
    style={`height: ${steps.length * 100}dvh;`}
>
    <div
        data-offer-sticky
        class="sticky top-0 h-[100dvh] flex items-center overflow-hidden"
    >
        <div class="offer-dots" aria-hidden="true"></div>
        <div class="container mx-auto w-full relative z-10">
            <div class="mx-auto max-w-5xl">
                <h2
                    class="mb-10 md:mb-14 text-sm md:text-base text-zinc-500"
                >
                    ¿Qué podemos construir?
                </h2>
                {/* Steps list — active goes solid, reveals desc */}
                <ol class="flex flex-col gap-6 md:gap-8">
                    {
                        steps.map((step, i) => (
                            <li>
                                <button
                                    type="button"
                                    data-step-item
                                    data-index={i}
                                    data-active={i === 0 ? "true" : "false"}
                                    class="step-item group block w-full text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 rounded-lg"
                                >
                                    <span class="step-title block text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight">
                                        {step.title}
                                    </span>
                                    <span class="step-desc block text-lg md:text-xl text-zinc-600 leading-relaxed max-w-3xl">
                                        {step.desc}
                                    </span>
                                </button>
                            </li>
                        ))
                    }

                    <li class="mt-4">
                        <Button link="/contacto">Solicitar diagnóstico</Button>
                    </li>
                </ol>
            </div>
        </div>
    </div>
</section>

<style>
    .offer-dots {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image: radial-gradient(
            circle,
            rgba(4, 120, 87, 0.7) 0.9px,
            transparent 1.2px
        );
        background-size: 13px 13px;
        opacity: 0.4;
        /* Soft top/bottom edges so the texture blends into neighbor
           sections instead of cutting hard at the boundary. */
        mask-image: linear-gradient(
            180deg,
            transparent 0%,
            #000 18%,
            #000 82%,
            transparent 100%
        );
        -webkit-mask-image: linear-gradient(
            180deg,
            transparent 0%,
            #000 18%,
            #000 82%,
            transparent 100%
        );
    }

    @media (min-width: 640px) {
        .offer-dots {
            background-image: radial-gradient(
                circle,
                rgba(4, 120, 87, 0.7) 1.2px,
                transparent 1.6px
            );
            background-size: 18px 18px;
        }
    }

    .step-title {
        color: rgb(212 212 216); /* zinc-300 */
        transition: color 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .step-item[data-active="true"] .step-title,
    .step-item:hover .step-title {
        color: rgb(24 24 27); /* zinc-900 */
    }

    .step-desc {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition:
            max-height 0.55s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.4s ease,
            margin-top 0.4s ease;
    }
    .step-item[data-active="true"] .step-desc {
        max-height: 14rem;
        opacity: 1;
        margin-top: 0.75rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .step-desc,
        .step-title {
            transition: none;
        }
    }
</style>

<script>
    const section = document.querySelector<HTMLElement>("[data-offer-steps]");

    if (section) {
        const count = Number(section.dataset.stepCount ?? "0");
        const sticky =
            section.querySelector<HTMLElement>("[data-offer-sticky]");
        const items = Array.from(
            section.querySelectorAll<HTMLElement>("[data-step-item]"),
        );

        let active = -1;
        let ticking = false;

        const setActive = (index: number) => {
            const next = Math.max(0, Math.min(count - 1, index));
            if (next === active) return;
            active = next;
            items.forEach((el) =>
                el.setAttribute(
                    "data-active",
                    el.dataset.index === String(next) ? "true" : "false",
                ),
            );
        };

        // Use the pinned element's own height (layout-driven, dvh) instead of
        // window.innerHeight — mobile toolbar show/hide won't drift the math.
        const viewport = () => sticky?.offsetHeight ?? window.innerHeight;

        const update = () => {
            ticking = false;
            const rect = section.getBoundingClientRect();
            const scrollable = section.offsetHeight - viewport();
            if (scrollable <= 0) {
                setActive(0);
                return;
            }
            // progress 0→1 across the pinned scroll distance
            const progress = Math.min(
                1,
                Math.max(0, -rect.top / scrollable),
            );
            setActive(Math.floor(progress * count - 0.0001));
        };

        const onScroll = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();

        // Click a title → scroll to that step
        items.forEach((item) => {
            item.addEventListener("click", () => {
                const i = Number(item.dataset.index ?? "0");
                const scrollable = section.offsetHeight - viewport();
                const top =
                    section.offsetTop +
                    (scrollable * (i + 0.5)) / count;
                window.scrollTo({
                    top,
                    behavior: window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches
                        ? "auto"
                        : "smooth",
                });
            });
        });
    }
</script>

