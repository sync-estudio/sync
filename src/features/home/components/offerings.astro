---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";
import { getLang, localizedPath } from "@i18n/utils";
import { home } from "@i18n/content/home";

const lang = getLang(Astro.currentLocale);
const copy = home[lang].offerings;

const themes = {
    dark: {
        card: "bg-zinc-900 text-zinc-100",
        title: "text-white",
        intro: "text-zinc-300",
        dots: "rgba(255,255,255,0.18)",
    },
    mid: {
        card: "bg-emerald-800 text-emerald-50",
        title: "text-white",
        intro: "text-emerald-100/90",
        dots: "rgba(255,255,255,0.18)",
    },
    light: {
        card: "bg-[#defbed] text-zinc-800",
        title: "text-zinc-900",
        intro: "text-zinc-700",
        dots: "rgba(4,120,87,0.35)",
    },
} as const;

const products = [
    {
        title: copy.platformsTitle,
        desc: copy.platformsDesc,
        theme: themes.light,
        aura: { x: "0%", y: "0%" },
    },
    {
        title: copy.aiTitle,
        desc: copy.aiDesc,
        theme: themes.dark,
        aura: { x: "50%", y: "50%" },
    },
    {
        title: copy.mvpTitle,
        desc: copy.mvpDesc,
        theme: themes.mid,
        aura: { x: "100%", y: "100%" },
    },
];
---

<section id="productos" class="container mx-auto py-24 md:py-32">
    <header
        class="max-w-3xl mx-auto flex flex-col gap-4 md:gap-5 text-center mb-16 md:mb-20"
    >
        <h2
            data-services-heading
            class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-[1.05] tracking-tight text-balance text-zinc-800 opacity-0"
        >
            {copy.eyebrow}
        </h2>
        <p
            data-services-sub
            class="text-base sm:text-lg md:text-xl text-zinc-500 leading-relaxed max-w-2xl mx-auto text-balance opacity-0"
        >
            {copy.subtitle}
        </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {
            products.map((product) => {
                const t = product.theme;
                return (
                    <article
                        data-services-card
                        style={`--services-dot-color: ${t.dots}; --services-mouse-x: ${product.aura.x}; --services-mouse-y: ${product.aura.y};`}
                        data-aura-x={product.aura.x}
                        data-aura-y={product.aura.y}
                        class={`services-card relative isolate overflow-hidden flex flex-col gap-4 p-8 md:p-10 rounded-3xl min-h-[18rem] md:min-h-[22rem] ${t.card} opacity-0 transition-transform duration-300 ease-out hover:-translate-y-1`}
                    >
                        <div class="relative z-10 flex flex-col gap-4">
                            <h3
                                class={`text-xl md:text-2xl font-semibold tracking-tight ${t.title}`}
                            >
                                {product.title}
                            </h3>
                            <p
                                class={`text-base md:text-lg leading-snug ${t.intro}`}
                            >
                                {product.desc}
                            </p>
                        </div>

                        <div class="services-dots" aria-hidden="true" />
                    </article>
                );
            })
        }
    </div>

    <div data-services-cta class="mt-12 md:mt-16 flex justify-center opacity-0">
        <Button link={localizedPath("contact", lang)}>{copy.cta}</Button>
    </div>
</section>

<style>
    .services-dots {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image: radial-gradient(
            circle,
            var(--services-dot-color) 1.2px,
            transparent 1.6px
        );
        background-size: 14px 14px;
        background-position: bottom right;
        mask-image: radial-gradient(
            circle 320px at var(--services-mouse-x, 100%)
                var(--services-mouse-y, 100%),
            #000 0%,
            rgba(0, 0, 0, 0.55) 35%,
            rgba(0, 0, 0, 0.2) 70%,
            rgba(0, 0, 0, 0.1) 100%
        );
        -webkit-mask-image: radial-gradient(
            circle 320px at var(--services-mouse-x, 100%)
                var(--services-mouse-y, 100%),
            #000 0%,
            rgba(0, 0, 0, 0.55) 35%,
            rgba(0, 0, 0, 0.2) 70%,
            rgba(0, 0, 0, 0.1) 100%
        );
    }

    @media (prefers-reduced-motion: reduce) {
        [data-services-heading],
        [data-services-sub],
        [data-services-card],
        [data-services-cta] {
            opacity: 1 !important;
        }
    }
</style>

<script>
    import { animate, inView, stagger } from "framer-motion";

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const heading = document.querySelector<HTMLElement>(
        "[data-services-heading]",
    );
    const sub = document.querySelector<HTMLElement>("[data-services-sub]");
    const cta = document.querySelector<HTMLElement>("[data-services-cta]");
    const cards = document.querySelectorAll<HTMLElement>(
        "[data-services-card]",
    );

    const fadeIn = (el: HTMLElement | null, y = 20, duration = 0.6) => {
        if (!el) return;
        if (prefersReducedMotion) {
            el.style.opacity = "1";
            return;
        }
        inView(
            el,
            () => {
                animate(
                    el,
                    {
                        opacity: [0, 1],
                        transform: [`translateY(${y}px)`, "translateY(0px)"],
                    },
                    { duration, ease: [0.22, 1, 0.36, 1] },
                );
            },
            { amount: 0.3 },
        );
    };

    fadeIn(heading, 20);
    fadeIn(sub, 16);
    fadeIn(cta, 12);

    if (cards.length) {
        if (prefersReducedMotion) {
            cards.forEach((el) => (el.style.opacity = "1"));
        } else {
            const first = cards[0];
            inView(
                first,
                () => {
                    animate(
                        cards,
                        {
                            opacity: [0, 1],
                            transform: ["translateY(24px)", "translateY(0px)"],
                        },
                        {
                            duration: 0.55,
                            ease: [0.22, 1, 0.36, 1],
                            delay: stagger(0.09),
                        },
                    );
                },
                { amount: 0.25 },
            );
        }
    }

    const supportsFinePointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)",
    ).matches;

    if (supportsFinePointer) {
        cards.forEach((card) => {
            const defaultX = card.dataset.auraX ?? "100%";
            const defaultY = card.dataset.auraY ?? "100%";
            let rafId = 0;
            let pendingX = defaultX;
            let pendingY = defaultY;
            let rect: DOMRect | null = null;

            const apply = () => {
                rafId = 0;
                card.style.setProperty("--services-mouse-x", pendingX);
                card.style.setProperty("--services-mouse-y", pendingY);
            };

            card.addEventListener("pointerenter", () => {
                rect = card.getBoundingClientRect();
            });

            card.addEventListener("pointermove", (e) => {
                if (!rect) rect = card.getBoundingClientRect();
                const x = ((e.clientX - rect.left) / rect.width) * 100;
                const y = ((e.clientY - rect.top) / rect.height) * 100;
                pendingX = `${x}%`;
                pendingY = `${y}%`;
                if (!rafId) rafId = requestAnimationFrame(apply);
            });

            card.addEventListener("pointerleave", () => {
                rect = null;
                pendingX = defaultX;
                pendingY = defaultY;
                if (!rafId) rafId = requestAnimationFrame(apply);
            });
        });
    }
</script>
