---
// Panel interno a medida — módulos que reflejan cómo opera la empresa. Voltaje único.
const title = "Panel · tu empresa";
const nav = [
    { t: "Pedidos", active: true },
    { t: "Inventario", active: false },
    { t: "Clientes", active: false },
    { t: "Reportes", active: false },
];
const rows = ["Aprobar compra", "Asignar pedido", "Cerrar mes"];
---

<div
    class="w-full max-w-md overflow-hidden rounded-2xl border border-emerald-800/60 bg-emerald-950 shadow-2xl shadow-emerald-950/40"
>
    {/* chrome */}
    <div
        class="relative flex items-center border-b border-emerald-800/50 px-4 py-3 md:px-5 md:py-3.5"
    >
        <div class="flex shrink-0 items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-600/50"></span>
        </div>
        <div
            class="pointer-events-none absolute inset-x-0 flex items-center justify-center text-emerald-100"
        >
            <span class="truncate font-mono text-xs tracking-tight md:text-sm">
                {title}
            </span>
        </div>
    </div>

    {/* body — sidebar + content */}
    <div class="flex aspect-[4/3] bg-emerald-950 text-sm">
        {/* sidebar */}
        <nav
            class="flex w-2/5 flex-col gap-1 border-r border-emerald-800/50 p-3 md:p-4"
        >
            {
                nav.map((n) => (
                    <span
                        class={`rounded-lg px-3 py-2 text-xs md:text-sm ${
                            n.active
                                ? "bg-emerald-800/50 font-medium text-emerald-50"
                                : "text-emerald-300/70"
                        }`}
                    >
                        {n.t}
                    </span>
                ))
            }
        </nav>

        {/* content */}
        <div class="flex flex-1 flex-col gap-3 p-4 md:p-5">
            <span class="text-xs font-medium text-emerald-100 md:text-sm">
                Pedidos
            </span>
            <div class="flex flex-col gap-2">
                {
                    rows.map((r) => (
                        <div class="flex items-center gap-2 text-xs text-emerald-200/80 md:text-sm">
                            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
                            <span class="flex-1">{r}</span>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</div>
