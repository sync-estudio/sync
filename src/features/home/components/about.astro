---
import "@app/styles/global.css";
---

<section
    id="nosotros"
    data-about
    class="flex min-h-[100dvh] items-center py-28 md:py-40 container mx-auto"
>
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
        <span class="text-sm md:text-base text-zinc-400 tracking-wide">
            ¿Por qué existimos?
        </span>

        <p
            data-fill
            class="mt-8 md:mt-10 text-2xl sm:text-3xl md:text-4xl leading-snug md:leading-[1.3] tracking-tight text-balance"
        >
            La mayoría de las agencias vende software que los equipos nunca
            llegan a operar. Eso no resuelve problemas, los disfraza. Sync existe
            para hacer lo opuesto: entendemos la operación real, educamos al
            equipo sobre sus cuellos de botella, y entregamos soluciones hechas
            para que tu equipo las opere — con mantenimiento continuo de nuestro
            lado.
        </p>

        <span class="mt-14 md:mt-20 flex items-center gap-3 text-sm md:text-base text-zinc-400">
            <span class="font-medium text-zinc-700">Yamil Yscapa</span>
            <span class="text-zinc-300" aria-hidden="true">•</span>
            <span>Co-fundador de Sync</span>
        </span>
    </div>

    <script>
        import gsap from "gsap";
        import { ScrollTrigger } from "gsap/ScrollTrigger";

        gsap.registerPlugin(ScrollTrigger);

        const DIM = "#d4d4d8"; // zinc-300
        const INK = "#27272a"; // zinc-800
        const ACCENT = "#047857"; // emerald-700

        function init() {
            const para = document.querySelector<HTMLElement>("[data-fill]");
            if (!para) return;

            // Split the paragraph into per-word spans so each can fill
            // independently as the reader scrolls. "Sync" fills to the brand
            // accent instead of ink.
            const words = (para.textContent ?? "").trim().split(/\s+/);
            para.innerHTML = words
                .map((w) => {
                    const clean = w.replace(/[^\p{L}]/gu, "").toLowerCase();
                    const ink = clean === "sync" ? ACCENT : INK;
                    return `<span class="fill-word" data-ink="${ink}">${w}</span>`;
                })
                .join(" ");
            const spans = gsap.utils.toArray<HTMLElement>(
                para.querySelectorAll(".fill-word"),
            );

            const reduce = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            if (reduce) {
                gsap.set(spans, { color: (_i, el) => el.dataset.ink });
                return;
            }

            gsap.set(spans, { color: DIM });

            // Words darken left-to-right tied to scroll position — the copy
            // "comes into focus" as it passes through the viewport.
            gsap.to(spans, {
                color: (_i, el) => el.dataset.ink,
                ease: "none",
                stagger: 1,
                scrollTrigger: {
                    trigger: para,
                    start: "top 85%",
                    end: "center center",
                    scrub: 0.5,
                },
            });
        }

        init();
    </script>
</section>
