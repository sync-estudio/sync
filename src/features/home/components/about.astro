---
import "@app/styles/global.css";
import { getLang } from "@i18n/utils";
import { home } from "@i18n/content/home";

const lang = getLang(Astro.currentLocale);
const copy = home[lang].about;
---

<section
    id="nosotros"
    data-about
    class="flex min-h-[100dvh] items-center py-28 md:py-40 container mx-auto"
>
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
        <span class="text-sm md:text-base text-zinc-500 tracking-wide">
            {copy.eyebrow}
        </span>

        <p
            data-fill
            class="mt-8 md:mt-10 text-2xl sm:text-3xl md:text-4xl leading-snug md:leading-[1.3] tracking-tight text-balance"
        >
            {copy.body}
        </p>

        <span class="mt-14 md:mt-20 flex items-center gap-3 text-sm md:text-base text-zinc-500">
            <span class="font-medium text-zinc-700">Yamil Yscapa</span>
            <span class="text-zinc-300" aria-hidden="true">•</span>
            <span>{copy.role}</span>
        </span>
    </div>

    <script>
        const DIM = "#d4d4d8"; // zinc-300
        const INK = "#27272a"; // zinc-800
        const ACCENT = "#047857"; // emerald-700

        // Split the paragraph into per-word spans so each can fill
        // independently as the reader scrolls. "Sync" fills to the brand
        // accent instead of ink.
        function buildWords(para: HTMLElement, reduce: boolean) {
            const fullText = (para.textContent ?? "").trim();
            const wordSpans = fullText
                .split(/\s+/)
                .map((w) => {
                    const clean = w.replace(/[^\p{L}]/gu, "").toLowerCase();
                    const ink = clean === "sync" ? ACCENT : INK;
                    // Inline the start color so there's no flash before GSAP
                    // loads: ink when reduced-motion, dim otherwise.
                    const start = reduce ? ink : DIM;
                    return `<span class="fill-word" data-ink="${ink}" style="color:${start}">${w}</span>`;
                })
                .join(" ");
            // The per-word fill is purely decorative and its dim start state
            // trips color-contrast, so hide it from assistive tech and expose
            // the sentence once via a screen-reader-only copy.
            para.innerHTML =
                `<span class="sr-only">${fullText}</span>` +
                `<span aria-hidden="true">${wordSpans}</span>`;
        }

        async function init() {
            const para = document.querySelector<HTMLElement>("[data-fill]");
            if (!para) return;

            const reduce = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            buildWords(para, reduce);

            // Reduced motion: words already at their ink color, no GSAP needed.
            if (reduce) return;

            // Defer the GSAP/ScrollTrigger bundle until the section is near
            // the viewport — keeps it out of the initial page load.
            const { default: gsap } = await import("gsap");
            const { ScrollTrigger } = await import("gsap/ScrollTrigger");
            gsap.registerPlugin(ScrollTrigger);

            const spans = gsap.utils.toArray<HTMLElement>(
                para.querySelectorAll(".fill-word"),
            );

            // Words darken left-to-right tied to scroll position — the copy
            // "comes into focus" as it passes through the viewport.
            gsap.to(spans, {
                color: (_i, el) => el.dataset.ink,
                ease: "none",
                stagger: 1,
                scrollTrigger: {
                    trigger: para,
                    start: "top 85%",
                    end: "center center",
                    scrub: 0.5,
                },
            });
        }

        const section = document.querySelector<HTMLElement>("#nosotros");
        if (section) {
            const io = new IntersectionObserver(
                (entries, obs) => {
                    if (entries.some((e) => e.isIntersecting)) {
                        obs.disconnect();
                        init();
                    }
                },
                { rootMargin: "300px" },
            );
            io.observe(section);
        } else {
            init();
        }
    </script>
</section>
