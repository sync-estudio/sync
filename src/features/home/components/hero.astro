---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";
---

<div
    id="inicio"
    class="pt-20 md:pt-20 pb-8 md:pb-12 container mx-auto flex justify-center items-center"
>
    <div
        data-hero-card
        class="hero-card relative isolate w-full min-h-[80vh] rounded-2xl md:rounded-3xl overflow-hidden border border-zinc-200 flex justify-center items-center px-6 sm:px-10 md:px-14 lg:px-20 py-20 md:py-24"
    >
    <pre data-hero-wave class="hero-wave" aria-hidden="true"></pre>
    <div
        class="flex flex-col gap-5 sm:gap-5 md:gap-6 lg:gap-7 w-full max-w-8xl lg:my-auto pt-0 lg:pt-20 relative z-10"
    >
        <div class="text-zinc-800 text-center">
            <h1
                class="text-[24px] sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-semibold mb-3 sm:mb-3 md:mb-4 leading-[1.2] md:leading-[1.1] px-0 sm:px-4 tracking-tight"
            >
                <span data-hero-line class="hero-line"
                    >Software e <span
                        class="font-[ibm-plex-serif] font-bold italic text-emerald-900 relative inline-block px-1.5 py-0.5 sm:px-3 sm:py-1.5 md:px-4 md:py-2"
                        ><span
                            class="absolute inset-0 bg-emerald-200/60 -rotate-1 transform origin-center rounded-sm -mx-1"
                        ></span><span class="relative z-10">IA</span></span> a medida para empresas en operación.</span
                >
            </h1>
            <p
                data-hero-line
                class="hero-line text-sm sm:text-base md:text-lg text-zinc-600 px-0 sm:px-4 max-w-3xl mx-auto leading-snug"
            >
                Construimos las herramientas, rediseñamos los flujos y formamos a tu equipo.
            </p>
        </div>

        <div
            data-hero-actions
            class="flex flex-wrap justify-center gap-3 sm:gap-3 md:gap-4 w-full px-4 sm:px-0 hero-actions"
        >
            <Button link="/contacto" style="w-full sm:w-auto">Solicitar diagnóstico estratégico</Button>
            <Button link="/#metodologia" variant="outline" style="w-full sm:w-auto">Conocer la metodología</Button>
        </div>
    </div>
    </div>
</div>

<style>
    .hero-card {
        position: relative;
    }

    .hero-wave {
        position: absolute;
        inset: 0;
        margin: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-weight: 700;
        color: rgba(4, 120, 87, 0.45);
        white-space: pre;
        user-select: none;
        line-height: 1;
        letter-spacing: 0.4em;
        mask-image: linear-gradient(
            90deg,
            transparent 0%,
            #000 3%,
            #000 97%,
            transparent 100%
        );
        -webkit-mask-image: linear-gradient(
            90deg,
            transparent 0%,
            #000 3%,
            #000 97%,
            transparent 100%
        );
    }

    .hero-line {
        display: block;
    }

    .hero-actions {
        animation: hero-actions-in 0.76s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
    }

    @keyframes hero-actions-in {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-actions {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
        }
    }

    @media (min-width: 640px) {
        #inicio img {
            max-height: 600px;
            min-height: 400px;
        }
    }

    @media (min-width: 768px) {
        #inicio img {
            max-height: 700px;
            min-height: 500px;
        }
    }

    @media (min-width: 1024px) {
        #inicio img {
            max-height: 800px;
            min-height: 600px;
        }
    }

    @media (min-width: 1280px) {
        #inicio img {
            max-height: 900px;
            min-height: 700px;
        }
    }
</style>

<script>
    const RAMP = "  ···";
    const FONT_PX = 13;
    const CELL_W = FONT_PX;
    const CELL_H = FONT_PX;

    function initWave(el: HTMLElement) {
        const card = el.parentElement as HTMLElement;
        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        let cols = 0;
        let rows = 0;
        let frame = 0;
        let base = 0;
        let ampA = 0;
        let ampB = 0;
        let thickness = 1;
        let freqA = 7;
        let freqB = 13;

        el.style.fontSize = FONT_PX + "px";

        function resize() {
            const rect = card.getBoundingClientRect();
            cols = Math.max(1, Math.floor(rect.width / CELL_W));
            rows = Math.max(1, Math.floor(rect.height / CELL_H));

            // Keep wavelength ~constant in px: ~one crest per 640px.
            const cycles = Math.max(1, rect.width / 640);
            freqA = cycles * Math.PI * 2;
            freqB = freqA * 1.85;

            // Push wave below the text on narrow screens.
            base = rect.width < 640 ? rows * 0.72 : rows * 0.5;
            // Cap amplitude by width so narrow/tall mobile cards stay gentle.
            ampA = Math.min(rows * 0.26, cols * 0.14);
            ampB = ampA * 0.5;
            thickness = Math.max(2, rows * 0.14);
        }

        function render(t: number) {
            const out: string[] = [];

            for (let y = 0; y < rows; y++) {
                let line = "";
                for (let x = 0; x < cols; x++) {
                    const u = x / cols;
                    const center =
                        base +
                        ampA * Math.sin(u * freqA + t) +
                        ampB * Math.sin(u * freqB - t * 0.7);
                    const d = Math.abs(y - center) / thickness;
                    // smooth bell falloff for gentle edges, constant along x
                    const intensity = Math.exp(-d * d * 1.4);
                    if (intensity <= 0.06) {
                        line += " ";
                    } else {
                        const idx = Math.min(
                            RAMP.length - 1,
                            Math.round(intensity * (RAMP.length - 1)),
                        );
                        line += RAMP[idx];
                    }
                }
                out.push(line);
            }
            el.textContent = out.join("\n");
        }

        function loop() {
            frame += 0.005;
            render(frame);
            requestAnimationFrame(loop);
        }

        let lastW = -1;
        function onResize() {
            const w = Math.round(card.getBoundingClientRect().width);
            // Ignore height-only changes (mobile address-bar show/hide on scroll).
            if (w === lastW) return;
            lastW = w;
            resize();
            if (reduce) render(0);
        }

        onResize();
        window.addEventListener("resize", onResize);
        window.addEventListener("orientationchange", onResize);

        if (reduce) {
            render(0);
        } else {
            requestAnimationFrame(loop);
        }
    }

    document
        .querySelectorAll<HTMLElement>("[data-hero-wave]")
        .forEach(initWave);
</script>

