---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";
---

<div
    id="hero"
    class="min-h-[90vh] py-20 md:py-24 container mx-auto flex justify-center items-center"
>
    <div
        class="flex flex-col gap-8 sm:gap-7 md:gap-8 lg:gap-10 w-full max-w-8xl lg:my-auto pt-0 lg:pt-20"
    >
        <div class="text-zinc-800 text-start">
            <h1
                class="text-4xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-semibold mb-4 sm:mb-4 md:mb-5 leading-tight md:leading-[1.1] px-2 sm:px-4 tracking-tight"
            >
                <span data-hero-line class="hero-line"
                    >Software a medida para empresas en operación, enfocado en</span
                >
                <span data-hero-line class="hero-line"
                    ><span
                        class="font-[ibm-plex-serif] font-bold italic text-emerald-900 relative inline-block px-2.5 py-1.5 sm:px-3 sm:py-1.5 md:px-4 md:py-2"
                        ><span
                            class="absolute inset-0 bg-emerald-200/60 -rotate-1 transform origin-center rounded-sm -mx-1"
                        ></span><span class="relative z-10">resultados reales.</span></span
                    ></span
                >
            </h1>
        </div>

        <div
            data-hero-actions
            class="flex flex-wrap justify-start gap-4 sm:gap-5 md:gap-6 w-full px-4 sm:px-0 hero-actions"
        >
            <Button link="/contact">Solicitar consultoría inicial</Button>
            <Button link="/contact" variant="ghost">Explorar soluciones</Button>
        </div>
    </div>
</div>

<style>
    .hero-line {
        display: block;
        opacity: 0;
        transform: translateX(44px);
        will-change: transform, opacity;
    }

    .hero-actions {
        opacity: 0;
        transform: translateY(24px);
        will-change: transform, opacity;
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-line,
        .hero-actions {
            opacity: 1 !important;
            transform: none !important;
        }
    }

    @media (min-width: 640px) {
        #hero img {
            max-height: 600px;
            min-height: 400px;
        }
    }

    @media (min-width: 768px) {
        #hero img {
            max-height: 700px;
            min-height: 500px;
        }
    }

    @media (min-width: 1024px) {
        #hero img {
            max-height: 800px;
            min-height: 600px;
        }
    }

    @media (min-width: 1280px) {
        #hero img {
            max-height: 900px;
            min-height: 700px;
        }
    }
</style>

<script>
    import { animate, stagger } from "framer-motion";

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;

    const lines = document.querySelectorAll<HTMLElement>("[data-hero-line]");
    const actions = document.querySelector<HTMLElement>("[data-hero-actions]");

    if (prefersReducedMotion) {
        lines.forEach((el) => {
            el.style.opacity = "1";
            el.style.transform = "none";
        });
        if (actions) {
            actions.style.opacity = "1";
            actions.style.transform = "none";
        }
    } else {
        if (lines.length) {
            animate(
                lines,
                { opacity: [0, 1], transform: ["translateX(44px)", "translateX(0px)"] },
                {
                    duration: 0.76,
                    ease: [0.22, 1, 0.36, 1],
                    delay: stagger(0.08, { startDelay: 0.1 }),
                }
            );
        }

        if (actions) {
            animate(
                actions,
                { opacity: [0, 1], transform: ["translateY(24px)", "translateY(0px)"] },
                { duration: 0.76, ease: [0.22, 1, 0.36, 1], delay: 0.35 }
            );
        }
    }
</script>
