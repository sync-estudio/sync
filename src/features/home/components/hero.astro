---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";
---

<div
    id="hero"
    class="pt-20 md:pt-20 pb-8 md:pb-12 container mx-auto flex justify-center items-center px-4 sm:px-6"
>
    <div
        class="hero-card relative w-full min-h-[80vh] rounded-2xl md:rounded-3xl overflow-hidden border border-zinc-200 flex justify-center items-center px-6 sm:px-10 md:px-14 lg:px-20 py-20 md:py-24"
    >
    <div
        class="flex flex-col gap-5 sm:gap-5 md:gap-6 lg:gap-7 w-full max-w-8xl lg:my-auto pt-0 lg:pt-20 relative z-10"
    >
        <div class="text-zinc-800 text-center md:text-start">
            <h1
                class="text-[26px] sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-semibold mb-3 sm:mb-3 md:mb-4 leading-[1.15] md:leading-[1.1] px-0 sm:px-4 tracking-tight"
            >
                <span data-hero-line class="hero-line"
                    >Software e <span
                        class="font-[ibm-plex-serif] font-bold italic text-emerald-900 relative inline-block px-1.5 py-1 sm:px-3 sm:py-1.5 md:px-4 md:py-2"
                        ><span
                            class="absolute inset-0 bg-emerald-200/60 -rotate-1 transform origin-center rounded-sm -mx-1"
                        ></span><span class="relative z-10">IA</span></span> a medida para empresas en operación.</span
                >
            </h1>
            <p
                data-hero-line
                class="hero-line text-sm sm:text-base md:text-lg text-zinc-600 px-0 sm:px-4 max-w-3xl mx-auto md:mx-0 leading-snug"
            >
                Construimos las herramientas, rediseñamos los flujos y formamos a tu equipo.
            </p>
        </div>

        <div
            data-hero-actions
            class="flex flex-wrap justify-center md:justify-start gap-3 sm:gap-3 md:gap-4 w-full px-4 sm:px-0 hero-actions"
        >
            <Button link="/contact">Solicitar diagnóstico estratégico</Button>
            <Button link="/contact" variant="outline">Conocer la metodología</Button>
        </div>
    </div>
    </div>
</div>

<style>
    .hero-card {
        position: relative;
        background-image: url('/bg_texture.png');
        background-size: 150px;
        background-repeat: repeat;
    }

    .hero-line {
        display: block;
        opacity: 0;
        transform: translateX(44px);
    }

    .hero-actions {
        opacity: 0;
        transform: translateY(24px);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-line,
        .hero-actions {
            opacity: 1 !important;
            transform: none !important;
        }
    }

    @media (min-width: 640px) {
        #hero img {
            max-height: 600px;
            min-height: 400px;
        }
    }

    @media (min-width: 768px) {
        #hero img {
            max-height: 700px;
            min-height: 500px;
        }
    }

    @media (min-width: 1024px) {
        #hero img {
            max-height: 800px;
            min-height: 600px;
        }
    }

    @media (min-width: 1280px) {
        #hero img {
            max-height: 900px;
            min-height: 700px;
        }
    }
</style>

<script>
    import { animate, stagger } from "framer-motion";

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;

    const lines = document.querySelectorAll<HTMLElement>("[data-hero-line]");
    const actions = document.querySelector<HTMLElement>("[data-hero-actions]");

    if (prefersReducedMotion) {
        lines.forEach((el) => {
            el.style.opacity = "1";
            el.style.transform = "none";
        });
        if (actions) {
            actions.style.opacity = "1";
            actions.style.transform = "none";
        }
    } else {
        if (lines.length) {
            animate(
                lines,
                { opacity: [0, 1], transform: ["translateX(44px)", "translateX(0px)"] },
                {
                    duration: 0.76,
                    ease: [0.22, 1, 0.36, 1],
                    delay: stagger(0.08, { startDelay: 0.1 }),
                }
            );
        }

        if (actions) {
            animate(
                actions,
                { opacity: [0, 1], transform: ["translateY(24px)", "translateY(0px)"] },
                { duration: 0.76, ease: [0.22, 1, 0.36, 1], delay: 0.35 }
            );
        }
    }
</script>
