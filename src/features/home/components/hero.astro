---
import "@app/styles/global.css";
import { Image } from "astro:assets";
import CalEmbed from "@shared/components/ui/cal-embed.astro";
import ArrowIcon from "@shared/components/ui/arrow-icon.astro";
import imaPreview from "@assets/case-studies/ima/dashboard-preview.webp";
import butaqueando from "@assets/projects/butaqueando.webp";
import { getLang, caseStudyPath } from "@i18n/utils";
import { home } from "@i18n/content/home";

const lang = getLang(Astro.currentLocale);
const copy = home[lang].hero;
const featured = home[lang].featured;

const buta = featured.projects.find((p) => p.id === "butaqueando");

// Same booking event as the contact page — hero CTA opens the Cal popup.
const calLink = "yamil-yscapa/diagnostico-gratuito";
---

<section id="inicio" class="container mx-auto pt-28 md:pt-36 pb-14 md:pb-20">
    <div
        class="flex flex-col items-center text-center w-full gap-5 md:gap-6"
    >
        <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight text-zinc-900 text-balance"
        >
            <span data-hero-line class="hero-line"
                >{copy.titleLead}<span class="text-emerald-700"
                    >{copy.titleHighlight}</span
                >{copy.titleTail}</span
            >
        </h1>

        <p
            data-hero-line
            class="hero-line text-[13px] sm:text-base md:text-lg text-zinc-500 max-w-4xl leading-snug sm:leading-relaxed"
        >
            {copy.subtitle}
        </p>

        <div
            data-hero-actions
            class="hero-actions flex flex-wrap justify-center gap-3 md:gap-4 w-full px-4 sm:px-0 mt-1"
        >
            <CalEmbed
                calLink={calLink}
                namespace="diagnostico-hero"
                label={copy.ctaPrimary}
                labelShort={copy.ctaPrimaryShort}
                variant="default"
                style="w-full sm:w-auto"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path></svg
                >
            </CalEmbed>
        </div>
    </div>

    <div
        class="hero-cards grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-14 md:mt-20"
    >
        <a
            href={caseStudyPath("ima-cloud", lang)}
            class="group relative isolate overflow-hidden rounded-2xl md:rounded-3xl bg-emerald-100/80 flex flex-col focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
            aria-label={`${copy.visual.name} — ${copy.visual.cta}`}
        >
            <div class="relative z-10 p-5 sm:p-6 md:p-7">
                <p
                    class="font-semibold text-zinc-900 text-base md:text-lg leading-tight"
                >
                    {copy.visual.name}
                </p>
                <p
                    class="mt-1.5 text-sm text-zinc-600 leading-snug max-w-sm text-balance"
                >
                    {copy.visual.caption}
                </p>
                <span
                    class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-800 underline-offset-4 group-hover:underline"
                >
                    {copy.visual.cta}
                    <ArrowIcon
                        size={13}
                        class="transition-transform duration-300 group-hover:translate-x-0.5"
                    />
                </span>
            </div>

            <Image
                class="mt-auto mx-auto w-[88%] max-w-none mb-[-6%] rounded-lg sm:rounded-xl border border-zinc-200/80 shadow-2xl transition-transform duration-[600ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-2"
                loading="eager"
                decoding="async"
                src={imaPreview}
                alt={copy.visual.imageAlt}
                format="webp"
                quality={80}
            />
        </a>

        <div
            class="relative isolate overflow-hidden rounded-2xl md:rounded-3xl bg-emerald-100/80 flex flex-col"
        >
            {
                buta && (
                    <>
                        <div class="relative z-10 p-5 sm:p-6 md:p-7">
                            <p class="font-semibold text-zinc-900 text-base md:text-lg leading-tight">
                                {buta.title}
                            </p>
                            <p class="mt-1 text-sm text-zinc-600 leading-snug max-w-sm text-balance">
                                {buta.description}
                            </p>
                        </div>
                        <Image
                            class="mt-auto mx-auto h-[360px] sm:h-[420px] lg:h-[460px] w-auto max-w-none mb-[-100px] lg:mb-[-130px] drop-shadow-2xl"
                            loading="eager"
                            decoding="async"
                            src={butaqueando}
                            alt={buta.imageAlt}
                            format="webp"
                            quality={80}
                        />
                    </>
                )
            }
        </div>
    </div>
</section>

<style>
    .hero-line {
        display: block;
    }

    .hero-actions {
        animation: hero-actions-in 0.76s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
    }

    .hero-cards {
        animation: hero-actions-in 0.76s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;
    }

    @keyframes hero-actions-in {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-actions,
        .hero-cards {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
        }
    }
</style>
