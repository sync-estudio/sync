---
// Teléfono — MVP en manos de gente real. Voltaje único, superficie esmeralda.
const flow = ["Validamos", "Construimos", "Crecemos"];
---

<div
    class="relative flex aspect-[9/18] h-full max-h-[24rem] flex-col rounded-3xl border border-emerald-800/60 bg-emerald-950 p-2.5 shadow-2xl shadow-emerald-950/40"
>
    {/* screen */}
    <div
        class="flex flex-1 flex-col items-center justify-center gap-2 rounded-2xl bg-emerald-950 px-5 text-center"
    >
        {
            flow.map((step, i) => (
                <>
                    <span class="text-base font-semibold tracking-tight text-emerald-50 md:text-lg">
                        {step}
                    </span>
                    {i < flow.length - 1 && (
                        <span class="text-emerald-400/80">↓</span>
                    )}
                </>
            ))
        }
    </div>

    {/* home indicator */}
    <div
        class="mx-auto mt-2 h-1 w-12 rounded-full bg-emerald-800/70"
    >
    </div>
</div>
