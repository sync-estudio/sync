---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";
import { solutions } from "@features/solutions/data";

const themes = {
    dark: {
        card: "bg-zinc-900 text-zinc-100",
        number: "text-emerald-300",
        title: "text-white",
        intro: "text-zinc-300",
        label: "text-emerald-300",
        bullet: "text-zinc-300",
        dot: "bg-emerald-300",
        divider: "border-zinc-800",
        deliverableLabel: "text-white",
        deliverableBody: "text-zinc-300",
        timingLabel: "text-zinc-300",
        timingBody: "text-zinc-400",
        ctaPill: "bg-white/10 hover:bg-white/20 text-white border-white/15",
        dots: "rgba(255,255,255,0.18)",
    },
    mid: {
        card: "bg-emerald-800 text-emerald-50",
        number: "text-emerald-200",
        title: "text-white",
        intro: "text-emerald-100/90",
        label: "text-emerald-200",
        bullet: "text-emerald-50",
        dot: "bg-emerald-200",
        divider: "border-emerald-700",
        deliverableLabel: "text-white",
        deliverableBody: "text-emerald-50/90",
        timingLabel: "text-emerald-100",
        timingBody: "text-emerald-100/80",
        ctaPill: "bg-white/10 hover:bg-white/20 text-white border-white/15",
        dots: "rgba(255,255,255,0.18)",
    },
    light: {
        card: "bg-[#defbed] text-zinc-800",
        number: "text-emerald-700",
        title: "text-zinc-900",
        intro: "text-zinc-700",
        label: "text-emerald-800",
        bullet: "text-zinc-700",
        dot: "bg-emerald-600",
        divider: "border-emerald-100",
        deliverableLabel: "text-zinc-900",
        deliverableBody: "text-zinc-700",
        timingLabel: "text-zinc-700",
        timingBody: "text-zinc-500",
        ctaPill:
            "bg-white hover:bg-zinc-50 text-emerald-800 border-emerald-200",
        dots: "rgba(4,120,87,0.35)",
    },
} as const;

const services = solutions.map((s) => ({ ...s, theme: themes[s.themeKey] }));
---

<section id="soluciones" class="container mx-auto py-24 md:py-32 px-4 sm:px-6">
    <header
        class="max-w-3xl mx-auto flex flex-col gap-5 md:gap-6 text-center mb-12 md:mb-16"
    >
        <h2
            data-services-heading
            class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight md:leading-[1.15] tracking-tight text-zinc-800 opacity-0"
        >
            Soluciones
        </h2>
        <p
            data-services-sub
            class="text-base sm:text-lg md:text-xl text-zinc-600 leading-relaxed max-w-2xl mx-auto opacity-0"
        >
            Diagnosticamos tu operación, desarrollamos las herramientas y
            formamos a tu equipo.
        </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        {
            services.map((service) => {
                const t = service.theme;
                return (
                    <article
                        data-services-card
                        style={`--services-dot-color: ${t.dots};`}
                        class={`services-card relative isolate overflow-hidden flex flex-col justify-between gap-10 p-8 md:p-10 rounded-3xl min-h-[22rem] md:min-h-[28rem] ${t.card} opacity-0 transition-transform duration-300 ease-out hover:-translate-y-1`}
                    >
                        <div class="relative z-10 flex flex-col gap-4">
                            <h3
                                class={`text-xl md:text-2xl font-semibold tracking-tight ${t.title}`}
                            >
                                {service.title}
                            </h3>
                            <p
                                class={`text-base md:text-lg leading-snug ${t.intro}`}
                            >
                                {service.intro}
                            </p>
                        </div>

                        <div class="relative z-10 flex flex-wrap items-center gap-3">
                            {service.cta && (
                                <Button
                                    link={service.cta.href}
                                    variant="outline"
                                >
                                    {service.cta.label}
                                </Button>
                            )}
                            <Button
                                link={`/soluciones/${service.id}`}
                                variant="outline"
                            >
                                Ver detalle
                            </Button>
                        </div>

                        <div class="services-dots" aria-hidden="true" />
                    </article>
                );
            })
        }
    </div>

    <div
        data-services-cta
        class="mt-12 md:mt-16 text-start opacity-0"
    >
        <p class="text-zinc-600 text-sm md:text-base">
            Las tres juntas. Entregar solo el software es desplazar el problema,
            no resolverlo.
        </p>
    </div>
</section>

<style>
    .services-dots {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image: radial-gradient(
            circle,
            var(--services-dot-color) 1.2px,
            transparent 1.6px
        );
        background-size: 14px 14px;
        background-position: bottom right;
        mask-image: radial-gradient(
            circle 320px at var(--services-mouse-x, 100%)
                var(--services-mouse-y, 100%),
            #000 0%,
            rgba(0, 0, 0, 0.55) 35%,
            rgba(0, 0, 0, 0.2) 70%,
            rgba(0, 0, 0, 0.1) 100%
        );
        -webkit-mask-image: radial-gradient(
            circle 320px at var(--services-mouse-x, 100%)
                var(--services-mouse-y, 100%),
            #000 0%,
            rgba(0, 0, 0, 0.55) 35%,
            rgba(0, 0, 0, 0.2) 70%,
            rgba(0, 0, 0, 0.1) 100%
        );
    }

    @media (prefers-reduced-motion: reduce) {
        [data-services-eyebrow],
        [data-services-heading],
        [data-services-sub],
        [data-services-card],
        [data-services-cta],
        [data-services-thread] {
            opacity: 1 !important;
        }
    }
</style>

<script>
    import { animate, inView, stagger } from "framer-motion";

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const eyebrow = document.querySelector<HTMLElement>(
        "[data-services-eyebrow]",
    );
    const heading = document.querySelector<HTMLElement>(
        "[data-services-heading]",
    );
    const sub = document.querySelector<HTMLElement>("[data-services-sub]");
    const cta = document.querySelector<HTMLElement>("[data-services-cta]");
    const cards = document.querySelectorAll<HTMLElement>(
        "[data-services-card]",
    );

    const fadeIn = (el: HTMLElement | null, y = 20, duration = 0.6) => {
        if (!el) return;
        if (prefersReducedMotion) {
            el.style.opacity = "1";
            return;
        }
        inView(
            el,
            () => {
                animate(
                    el,
                    {
                        opacity: [0, 1],
                        transform: [`translateY(${y}px)`, "translateY(0px)"],
                    },
                    { duration, ease: [0.22, 1, 0.36, 1] },
                );
            },
            { amount: 0.3 },
        );
    };

    fadeIn(eyebrow, 12, 0.5);
    fadeIn(heading, 20);
    fadeIn(sub, 16);
    fadeIn(cta, 12);

    if (cards.length) {
        if (prefersReducedMotion) {
            cards.forEach((el) => (el.style.opacity = "1"));
        } else {
            const first = cards[0];
            inView(
                first,
                () => {
                    animate(
                        cards,
                        {
                            opacity: [0, 1],
                            transform: ["translateY(24px)", "translateY(0px)"],
                        },
                        {
                            duration: 0.55,
                            ease: [0.22, 1, 0.36, 1],
                            delay: stagger(0.09),
                        },
                    );
                },
                { amount: 0.25 },
            );
        }
    }

    const supportsFinePointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)",
    ).matches;

    if (supportsFinePointer) {
        cards.forEach((card) => {
            let rafId = 0;
            let pendingX = "100%";
            let pendingY = "100%";
            let rect: DOMRect | null = null;

            const apply = () => {
                rafId = 0;
                card.style.setProperty("--services-mouse-x", pendingX);
                card.style.setProperty("--services-mouse-y", pendingY);
            };

            card.addEventListener("pointerenter", () => {
                rect = card.getBoundingClientRect();
            });

            card.addEventListener("pointermove", (e) => {
                if (!rect) rect = card.getBoundingClientRect();
                const x = ((e.clientX - rect.left) / rect.width) * 100;
                const y = ((e.clientY - rect.top) / rect.height) * 100;
                pendingX = `${x}%`;
                pendingY = `${y}%`;
                if (!rafId) rafId = requestAnimationFrame(apply);
            });

            card.addEventListener("pointerleave", () => {
                rect = null;
                pendingX = "100%";
                pendingY = "100%";
                if (!rafId) rafId = requestAnimationFrame(apply);
            });
        });
    }
</script>
