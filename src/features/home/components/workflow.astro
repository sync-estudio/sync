---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";

const phases = [
    {
        number: "01",
        title: "Diagnóstico",
        body: "Entendemos tu operación real, mapeamos procesos, identificamos pain points y entregamos un roadmap priorizado por impacto.",
    },
    {
        number: "02",
        title: "Construcción",
        body: "Construimos las herramientas y los flujos. Trabajamos contigo con entregas frecuentes y tu equipo como aprobador.",
    },
    {
        number: "03",
        title: "Capacitación",
        body: "Tu equipo aprende a operar y evolucionar el sistema. Talleres prácticos, documentación operativa, playbooks por rol.",
    },
    {
        number: "04",
        title: "Acompañamiento",
        body: "Monitoreo, optimización y evolución para que el sistema crezca contigo, no envejezca contigo.",
        note: "Modelo mensual.",
    },
];
---

<section
    id="workflow"
    data-workflow
    class="workflow-section relative py-20 md:py-0"
>
    <div
        data-workflow-stage
        class="workflow-stage container mx-auto flex items-center"
    >
        <div class="grid md:grid-cols-12 gap-10 md:gap-16 w-full">
            <div
                class="md:col-span-5 flex flex-col gap-5"
            >
                <span
                    data-workflow-eyebrow
                    class="text-xs tracking-[0.2em] text-emerald-700 font-semibold opacity-0"
                    >Metodología</span
                >
                <h2
                    data-workflow-heading
                    class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight md:leading-[1.15] tracking-tight text-zinc-800 opacity-0"
                >
                    Cómo trabajamos
                    <span
                        class="font-[ibm-plex-serif] font-bold italic text-emerald-900 relative inline-block px-2.5 py-1 sm:px-3 md:px-4"
                        ><span
                            class="absolute inset-0 bg-emerald-200/60 -rotate-1 transform origin-center rounded-sm -mx-1"
                        ></span><span class="relative z-10">contigo</span></span
                    >
                </h2>
                <p
                    data-workflow-sub
                    class="text-base sm:text-lg text-zinc-600 leading-snug max-w-md opacity-0"
                >
                    4 fases, cada una con entregables claros y aprobación de tu
                    equipo antes de avanzar.
                </p>

                <div
                    data-workflow-cta
                    class="mt-6 opacity-0"
                >
                    <Button link="/contact" variant="ghost"
                        >Ver la metodología completa</Button
                    >
                </div>
            </div>

            <div class="md:col-span-7 relative">
                <div
                    class="absolute left-5 md:left-6 top-2 bottom-2 w-px bg-zinc-200"
                    aria-hidden="true"
                >
                </div>
                <div
                    data-line-fill
                    class="absolute left-5 md:left-6 top-2 w-px bg-emerald-700 origin-top"
                    style="height: calc(100% - 1rem); transform: scaleY(0);"
                    aria-hidden="true"
                >
                </div>

                <ol class="flex flex-col gap-7 md:gap-8 relative z-10">
                    {
                        phases.map((phase) => (
                            <li
                                data-workflow-phase
                                class="phase-item relative pl-16 md:pl-20"
                            >
                                <span
                                    data-phase-marker
                                    class="absolute left-0 top-0 z-10 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white border border-zinc-200 flex items-center justify-center font-[ibm-plex-serif] italic font-bold text-emerald-900 text-base md:text-lg shadow-sm transition-colors duration-300"
                                >
                                    {phase.number}
                                </span>
                                <div class="flex flex-col gap-1.5 md:gap-2">
                                    <h3 class="text-lg md:text-xl font-semibold text-zinc-900 tracking-tight">
                                        {phase.title}
                                    </h3>
                                    <p class="text-zinc-600 text-sm md:text-[15px] leading-relaxed max-w-xl">
                                        {phase.body}
                                    </p>
                                    {phase.note && (
                                        <p class="text-xs md:text-sm text-emerald-800 font-medium mt-1">
                                            {phase.note}
                                        </p>
                                    )}
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </div>
    </div>

</section>

<style is:global>
    @media (min-width: 768px) {
        section[data-workflow] {
            height: 220vh;
        }

        [data-workflow-stage] {
            position: -webkit-sticky;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow: hidden;
            padding-top: 6rem;
            padding-bottom: 4rem;
        }
    }
</style>

<style>
    .phase-item > div {
        color: rgb(212 212 216);
        transition: color 400ms ease, transform 400ms ease;
        transform: translateY(8px);
    }

    .phase-item > div h3 {
        color: rgb(212 212 216);
        transition: color 400ms ease;
    }

    .phase-item > div p {
        color: rgb(212 212 216);
        transition: color 400ms ease;
    }

    .phase-item.is-active > div,
    .phase-item.is-visited > div {
        transform: translateY(0);
    }

    .phase-item.is-active > div h3 {
        color: rgb(24 24 27);
    }

    .phase-item.is-active > div p {
        color: rgb(82 82 91);
    }

    .phase-item.is-visited > div h3 {
        color: rgb(82 82 91);
    }

    .phase-item.is-visited > div p {
        color: rgb(161 161 170);
    }
</style>

<script>
    import { animate, inView, scroll } from "framer-motion";

    const section = document.querySelector<HTMLElement>("[data-workflow]");
    const eyebrow = document.querySelector<HTMLElement>("[data-workflow-eyebrow]");
    const heading = document.querySelector<HTMLElement>("[data-workflow-heading]");
    const sub = document.querySelector<HTMLElement>("[data-workflow-sub]");
    const cta = document.querySelector<HTMLElement>("[data-workflow-cta]");
    const lineFill = document.querySelector<HTMLElement>("[data-line-fill]");
    const phases = Array.from(
        document.querySelectorAll<HTMLElement>("[data-workflow-phase]")
    );
    const markers = Array.from(
        document.querySelectorAll<HTMLElement>("[data-phase-marker]")
    );

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;
    const isDesktop = window.matchMedia("(min-width: 768px)").matches;

    const setMarkerActive = (marker: HTMLElement, active: boolean) => {
        marker.style.background = active ? "rgb(6 95 70)" : "white";
        marker.style.color = active ? "white" : "rgb(6 78 59)";
        marker.style.borderColor = active
            ? "rgb(6 95 70)"
            : "rgb(228 228 231)";
    };

    if (prefersReducedMotion) {
        [eyebrow, heading, sub, cta].forEach((el) => {
            if (el) {
                el.style.opacity = "1";
                el.style.transform = "none";
            }
        });
        if (lineFill) lineFill.style.transform = "scaleY(1)";
        phases.forEach((p) => p.classList.add("is-active"));
        markers.forEach((m) => setMarkerActive(m, true));
    } else {
        const EASE = [0.22, 1, 0.36, 1] as const;

        const fadeUp = (el: HTMLElement, delay = 0, distance = 20) => {
            inView(
                el,
                () => {
                    animate(
                        el,
                        {
                            opacity: [0, 1],
                            transform: [
                                `translateY(${distance}px)`,
                                "translateY(0px)",
                            ],
                        },
                        { duration: 0.7, ease: EASE, delay }
                    );
                },
                { amount: 0.4 }
            );
        };

        if (eyebrow) fadeUp(eyebrow, 0, 12);
        if (heading) fadeUp(heading, 0.05, 24);
        if (sub) fadeUp(sub, 0.12, 20);
        if (cta) fadeUp(cta, 0.2, 16);

        if (section && lineFill) {
            const total = phases.length;
            let lastIdx = -1;

            const updateProgress = (raw: number) => {
                const eased = Math.min(1, Math.max(0, raw));
                lineFill.style.transform = `scaleY(${eased})`;

                const stepped = Math.min(
                    total - 1,
                    Math.floor(eased * total + 0.15)
                );

                if (stepped !== lastIdx) {
                    lastIdx = stepped;
                    phases.forEach((phase, idx) => {
                        phase.classList.toggle("is-active", idx === stepped);
                        phase.classList.toggle(
                            "is-visited",
                            idx < stepped
                        );
                    });
                    markers.forEach((marker, idx) =>
                        setMarkerActive(marker, idx <= stepped)
                    );
                }
            };

            scroll(updateProgress, {
                target: section,
                offset: (isDesktop
                    ? ["start start", "end end"]
                    : ["start 80%", "end 20%"]) as any,
            });
        }
    }
</script>
