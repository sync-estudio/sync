---
import "@app/styles/global.css";
import Button from "@shared/components/ui/button.astro";

interface Props {
    detailed?: boolean;
}

const { detailed = false } = Astro.props;

const phases = [
    {
        number: "01",
        title: "Diagnóstico",
        body: "Dos semanas dentro de tu operación: dónde se atasca el trabajo, qué datos viven en archivos sueltos y qué procesos siguen vivos por costumbre. Salimos con un plan, no con una propuesta comercial.",
        deliverables: [
            "Mapa de procesos y stack actual",
            "Pain points priorizados por impacto y esfuerzo",
            "Roadmap con fases y dependencias claras",
            "Métricas base para medir el antes y el después",
        ],
    },
    {
        number: "02",
        title: "Desarrollo",
        body: "Construimos las soluciones que tu operación necesita iterando sobre el roadmap acordado. Cada release pasa por tu equipo antes de tocar su día a día, y se queda en producción sólo si resuelve el problema real.",
        deliverables: [
            "Sprints de 1 a 2 semanas con demo en vivo",
            "Integraciones funcionando en producción, no en slides",
            "Repositorio y documentación técnica entregables",
            "Aprobación de tu equipo antes de cada release",
        ],
    },
    {
        number: "03",
        title: "Educación",
        body: "Tu equipo aprende a operar el sistema con confianza en el día a día, mientras nosotros lo mantenemos y evolucionamos detrás. Plan de Acompañamiento mensual incluido por defecto.",
        note: "Plan de Acompañamiento incluido.",
        deliverables: [
            "Talleres prácticos por rol, no charlas genéricas",
            "Playbooks y documentación viva, versionada con el código",
            "Mantenimiento del sistema en producción del lado nuestro",
            "Iteraciones mensuales priorizadas por impacto",
        ],
    },
];
---

<section
    id="metodologia"
    data-workflow
    data-detailed={detailed ? "true" : undefined}
    class:list={[
        "workflow-section relative",
        detailed ? "py-16 md:py-24" : "py-20 md:py-0",
    ]}
>
    {detailed ? (
        <div class="container mx-auto flex flex-col gap-12 md:gap-16">
            <div
                class="flex flex-col items-center text-center gap-5 max-w-4xl mx-auto pt-2 pb-10 md:pb-14"
            >
                <span
                    data-workflow-eyebrow
                    class="relative z-10 text-xs tracking-[0.2em] text-emerald-700 font-semibold opacity-0"
                >
                    Proceso
                </span>
                <h1
                    data-workflow-heading
                    class="relative z-10 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] tracking-tight text-zinc-900 opacity-0"
                >
                    Diagnóstico, desarrollo y
                    <span class="text-emerald-700">educación</span>
                </h1>
                <p
                    data-workflow-sub
                    class="relative z-10 text-base sm:text-lg text-zinc-600 leading-relaxed max-w-2xl opacity-0"
                >
                    Cada fase cierra con una decisión de tu equipo: aprueba el siguiente paso o paramos a corregir. Nada avanza por inercia, nada se factura sin que sirva.
                </p>
                <div data-workflow-cta class="relative z-10 mt-6 opacity-0">
                    <Button link="/contacto" variant="outline">Hablemos</Button>
                </div>
            </div>

            <div class="flex flex-col gap-5 md:gap-6 max-w-3xl mx-auto w-full">
                {phases.map((phase) => (
                    <article
                        data-workflow-card
                        class="phase-card group relative flex flex-col gap-5 rounded-2xl md:rounded-3xl border border-zinc-200 bg-white p-8 md:p-10 opacity-0 transition-colors duration-300 hover:border-emerald-700/30"
                    >
                        <div class="flex items-center gap-4">
                            <span class="inline-flex h-12 w-12 md:h-14 md:w-14 items-center justify-center rounded-full bg-emerald-50 border border-emerald-200/60 font-semibold text-emerald-800 text-lg md:text-xl">
                                {phase.number}
                            </span>
                            <h2 class="text-xl md:text-2xl font-semibold text-zinc-900 tracking-tight">
                                {phase.title}
                            </h2>
                        </div>

                        <p class="text-zinc-600 text-[15px] md:text-base leading-relaxed">
                            {phase.body}
                        </p>

                        {phase.deliverables && (
                            <div class="flex flex-col gap-3 pt-2 border-t border-zinc-100">
                                <span class="text-xs tracking-wide font-medium text-zinc-500">
                                    Entregables
                                </span>
                                <ul class="flex flex-col gap-2.5">
                                    {phase.deliverables.map((item) => (
                                        <li class="flex gap-3 text-sm md:text-[15px] text-zinc-700 leading-relaxed">
                                            <span
                                                aria-hidden="true"
                                                class="mt-[9px] h-1.5 w-1.5 rounded-full bg-emerald-700 shrink-0"
                                            />
                                            <span>{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}

                        {phase.note && (
                            <p class="text-xs md:text-sm text-emerald-800 font-medium">
                                {phase.note}
                            </p>
                        )}
                    </article>
                ))}
            </div>
        </div>
    ) : (
        <div
            data-workflow-stage
            class="workflow-stage container mx-auto flex items-center"
        >
            <div class="grid md:grid-cols-12 gap-10 md:gap-16 w-full">
                <div class="md:col-span-5 flex flex-col gap-5">
                    <span
                        data-workflow-eyebrow
                        class="text-xs tracking-[0.2em] text-emerald-700 font-semibold opacity-0"
                    >
                        Metodología
                    </span>
                    <h2
                        data-workflow-heading
                        class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight md:leading-[1.15] tracking-tight text-zinc-800 opacity-0"
                    >
                        Cómo trabajamos
                        <span class="text-emerald-700">contigo</span>
                    </h2>
                    <p
                        data-workflow-sub
                        class="text-base sm:text-lg text-zinc-600 leading-snug max-w-md opacity-0"
                    >
                        3 fases, cada una con entregables claros y aprobación de
                        tu equipo antes de avanzar.
                    </p>

                    <div data-workflow-cta class="mt-6 opacity-0">
                        <Button link="/como-trabajamos" variant="outline">
                            Ver la metodología completa
                        </Button>
                    </div>
                </div>

                <div class="md:col-span-7 relative">
                    <div
                        class="absolute left-5 md:left-6 top-2 bottom-2 w-px bg-zinc-200"
                        aria-hidden="true"
                    />
                    <div
                        data-line-fill
                        class="absolute left-5 md:left-6 top-2 w-px bg-emerald-700 origin-top"
                        style="height: calc(100% - 1rem); transform: scaleY(0);"
                        aria-hidden="true"
                    />

                    <ol class="flex flex-col gap-7 md:gap-8 relative z-10">
                        {phases.map((phase) => (
                            <li
                                data-workflow-phase
                                class="phase-item relative pl-16 md:pl-20"
                            >
                                <span
                                    data-phase-marker
                                    class="absolute left-0 top-0 z-10 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white border border-zinc-200 flex items-center justify-center font-semibold text-emerald-800 text-base md:text-lg shadow-sm transition-colors duration-300"
                                >
                                    {phase.number}
                                </span>
                                <div class="flex flex-col gap-1.5 md:gap-2">
                                    <h3 class="text-lg md:text-xl font-semibold text-zinc-900 tracking-tight">
                                        {phase.title}
                                    </h3>
                                    <p class="text-zinc-600 text-sm md:text-[15px] leading-relaxed max-w-xl">
                                        {phase.body}
                                    </p>
                                    {phase.note && (
                                        <p class="text-xs md:text-sm text-emerald-800 font-medium mt-1">
                                            {phase.note}
                                        </p>
                                    )}
                                </div>
                            </li>
                        ))}
                    </ol>
                </div>
            </div>
        </div>
    )}
</section>

<style is:global>
    @media (min-width: 768px) {
        section[data-workflow]:not([data-detailed]) {
            height: 220vh;
        }

        section[data-workflow]:not([data-detailed]) [data-workflow-stage] {
            position: -webkit-sticky;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow: hidden;
            padding-top: 6rem;
            padding-bottom: 4rem;
        }
    }
</style>

<style>
    .phase-item > div {
        color: rgb(212 212 216);
        transition: color 400ms ease, transform 400ms ease;
        transform: translateY(8px);
    }

    .phase-item > div h3 {
        color: rgb(212 212 216);
        transition: color 400ms ease;
    }

    .phase-item > div p {
        color: rgb(212 212 216);
        transition: color 400ms ease;
    }

    .phase-item.is-active > div,
    .phase-item.is-visited > div {
        transform: translateY(0);
    }

    .phase-item.is-active > div h3 {
        color: rgb(24 24 27);
    }

    .phase-item.is-active > div p {
        color: rgb(82 82 91);
    }

    .phase-item.is-visited > div h3 {
        color: rgb(82 82 91);
    }

    .phase-item.is-visited > div p {
        color: rgb(161 161 170);
    }
</style>

<script>
    import { animate, inView, scroll } from "framer-motion";

    const section = document.querySelector<HTMLElement>("[data-workflow]");
    const eyebrow = document.querySelector<HTMLElement>("[data-workflow-eyebrow]");
    const heading = document.querySelector<HTMLElement>("[data-workflow-heading]");
    const sub = document.querySelector<HTMLElement>("[data-workflow-sub]");
    const cta = document.querySelector<HTMLElement>("[data-workflow-cta]");
    const lineFill = document.querySelector<HTMLElement>("[data-line-fill]");
    const phases = Array.from(
        document.querySelectorAll<HTMLElement>("[data-workflow-phase]")
    );
    const markers = Array.from(
        document.querySelectorAll<HTMLElement>("[data-phase-marker]")
    );
    const cards = Array.from(
        document.querySelectorAll<HTMLElement>("[data-workflow-card]")
    );

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;
    const isDesktop = window.matchMedia("(min-width: 768px)").matches;

    const setMarkerActive = (marker: HTMLElement, active: boolean) => {
        marker.style.background = active ? "rgb(6 95 70)" : "white";
        marker.style.color = active ? "white" : "rgb(6 78 59)";
        marker.style.borderColor = active
            ? "rgb(6 95 70)"
            : "rgb(228 228 231)";
    };

    if (prefersReducedMotion) {
        [eyebrow, heading, sub, cta].forEach((el) => {
            if (el) {
                el.style.opacity = "1";
                el.style.transform = "none";
            }
        });
        if (lineFill) lineFill.style.transform = "scaleY(1)";
        phases.forEach((p) => p.classList.add("is-active"));
        markers.forEach((m) => setMarkerActive(m, true));
        cards.forEach((c) => {
            c.style.opacity = "1";
            c.style.transform = "none";
        });
    } else {
        const EASE = [0.22, 1, 0.36, 1] as const;

        const fadeUp = (el: HTMLElement, delay = 0, distance = 20) => {
            inView(
                el,
                () => {
                    animate(
                        el,
                        {
                            opacity: [0, 1],
                            transform: [
                                `translateY(${distance}px)`,
                                "translateY(0px)",
                            ],
                        },
                        { duration: 0.7, ease: EASE, delay }
                    );
                },
                { amount: 0.4 }
            );
        };

        if (eyebrow) fadeUp(eyebrow, 0, 12);
        if (heading) fadeUp(heading, 0.05, 24);
        if (sub) fadeUp(sub, 0.12, 20);
        if (cta) fadeUp(cta, 0.2, 16);

        cards.forEach((card, idx) => fadeUp(card, idx * 0.09, 24));

        if (section && lineFill) {
            const total = phases.length;
            let lastIdx = -1;

            const updateProgress = (raw: number) => {
                const eased = Math.min(1, Math.max(0, raw));
                lineFill.style.transform = `scaleY(${eased})`;

                const stepped = Math.min(
                    total - 1,
                    Math.floor(eased * total + 0.15)
                );

                if (stepped !== lastIdx) {
                    lastIdx = stepped;
                    phases.forEach((phase, idx) => {
                        phase.classList.toggle("is-active", idx === stepped);
                        phase.classList.toggle(
                            "is-visited",
                            idx < stepped
                        );
                    });
                    markers.forEach((marker, idx) =>
                        setMarkerActive(marker, idx <= stepped)
                    );
                }
            };

            scroll(updateProgress, {
                target: section,
                offset: (isDesktop
                    ? ["start start", "end end"]
                    : ["start 80%", "end 20%"]) as any,
            });
        }
    }
</script>
