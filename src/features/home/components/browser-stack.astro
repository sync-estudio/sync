---
// Ventana de navegador — cliente final. Voltaje único: superficie esmeralda oscura.
const url = "customer.domain.com";
---

<div
    class="w-full max-w-md overflow-hidden rounded-2xl border border-emerald-800/60 bg-emerald-950 shadow-2xl shadow-emerald-950/40"
>
    {/* chrome */}
    <div
        class="relative flex items-center border-b border-emerald-800/50 px-4 py-3 md:px-5 md:py-3.5"
    >
        <div class="flex shrink-0 items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-600/50"></span>
        </div>
        <div
            class="pointer-events-none absolute inset-x-0 flex items-center justify-center gap-1.5 text-emerald-100"
        >
            <svg
                class="h-3 w-3 shrink-0 opacity-70"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span class="truncate font-mono text-xs tracking-tight md:text-sm">
                {url}
            </span>
        </div>
    </div>

    {/* body */}
    <div
        class="flex aspect-[4/3] items-center justify-center bg-emerald-950 px-6"
    >
        <div
            class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-base font-semibold tracking-tight md:text-lg"
        >
            <span class="text-emerald-50">Validamos</span>
            <span class="text-emerald-400/80">→</span>
            <span class="text-emerald-50">Construimos</span>
            <span class="text-emerald-400/80">→</span>
            <span class="text-emerald-50">Crecemos</span>
        </div>
    </div>
</div>
