---
// Terminal de agente — lenguaje claro para el cliente, no técnico. Voltaje único.
const title = "Tu agente · Facturación";
const lines = [
    { t: "Lee los correos de tus clientes", done: true },
    { t: "Crea las facturas", done: true },
    { t: "Concilia los pagos recibidos", done: true },
    { t: "Te avisa si algo no cuadra", done: false },
];
---

<div
    class="w-full max-w-md overflow-hidden rounded-2xl border border-emerald-800/60 bg-emerald-950 shadow-2xl shadow-emerald-950/40"
>
    {/* chrome */}
    <div
        class="relative flex items-center border-b border-emerald-800/50 px-4 py-3 md:px-5 md:py-3.5"
    >
        <div class="flex shrink-0 items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-600/50"></span>
        </div>
        <div
            class="pointer-events-none absolute inset-x-0 flex items-center justify-center text-emerald-100"
        >
            <span class="truncate font-mono text-xs tracking-tight md:text-sm">
                {title}
            </span>
        </div>
    </div>

    {/* body */}
    <div class="aspect-[4/3] bg-emerald-950 px-5 py-4 md:px-6 md:py-5">
        <div
            class="flex h-full flex-col justify-center gap-1.5 font-mono text-xs text-emerald-100 md:text-sm"
        >
            {
                lines.map((l) => (
                    <div class="flex items-start gap-2">
                        <span class="text-emerald-400">›</span>
                        <span class="flex-1">{l.t}</span>
                        {l.done && <span class="text-emerald-400">✓</span>}
                    </div>
                ))
            }
            <div class="flex items-center gap-2 text-emerald-400">
                <span>›</span>
                <span
                    class="agent-caret inline-block h-3.5 w-2 bg-emerald-400 md:h-4"
                ></span>
            </div>
        </div>
    </div>
</div>

<style>
    .agent-caret {
        animation: agent-blink 1.1s steps(1) infinite;
    }
    @keyframes agent-blink {
        0%,
        50% {
            opacity: 1;
        }
        50.01%,
        100% {
            opacity: 0;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .agent-caret {
            animation: none;
        }
    }
</style>
