---
interface Props {
    imageSrc: string;
    imageAlt: string;
    projectName: string;
    description: string;
    imageClasses?: string;
    link?: string;
}

const {
    imageSrc,
    imageAlt,
    projectName,
    description,
    imageClasses = "",
    link,
} = Astro.props;
---

<article class="relative flex flex-col text-start text-zinc-600">
    {link && (
        <a
            href={link}
            aria-label={`Ver caso de estudio de ${projectName}`}
            class="absolute inset-0 z-10 rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-700/40"
        >
            <span class="sr-only">Ver caso de estudio de {projectName}</span>
        </a>
    )}

    <div
        class="bg-emerald-50/70 rounded-2xl flex items-center justify-center p-8 md:p-12 lg:p-16 overflow-hidden h-[320px] sm:h-[420px] md:h-[520px] lg:h-[600px]"
    >
        <img
            class={`max-h-full w-auto max-w-full object-contain ${imageClasses}`}
            loading="lazy"
            src={imageSrc}
            alt={imageAlt}
        />
    </div>

    <p class="text-zinc-500 mt-4">{projectName}</p>
    <h3 class="font-semibold text-lg md:text-xl">{description}</h3>
</article>

