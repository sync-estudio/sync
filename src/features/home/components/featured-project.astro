---
import Button from "@shared/components/ui/button.astro";

interface Props {
    imageSrc: string;
    imageAlt: string;
    title: string;
    description: string;
    imageClasses?: string;
    link?: string;
    linkLabel?: string;
    spanClass?: string;
}

const {
    imageSrc,
    imageAlt,
    title,
    description,
    imageClasses = "",
    link,
    linkLabel = "Ver caso de estudio",
    spanClass = "",
} = Astro.props;
---

<article
    class:list={[
        "flex flex-col h-full text-start text-zinc-600",
        spanClass,
    ]}
>
    <div
        class="bg-emerald-100/80 rounded-2xl md:rounded-3xl flex items-center justify-center p-4 md:p-6 overflow-hidden h-72 md:h-96"
    >
        <img
            class:list={[
                "max-h-full w-auto max-w-full object-contain",
                imageClasses,
            ]}
            loading="lazy"
            decoding="async"
            src={imageSrc}
            alt={imageAlt}
        />
    </div>

    <div class="flex flex-col gap-4 pt-5 flex-1">
        <div class="flex flex-col gap-2">
            <h3 class="font-semibold text-xl md:text-2xl leading-tight tracking-tight text-zinc-800">
                {title}
            </h3>
            <p class="text-zinc-500 leading-relaxed text-balance">
                {description}
            </p>
        </div>

        {
            link && (
                <div class="mt-auto pt-1">
                    <Button link={link} variant="outline">
                        {linkLabel}
                    </Button>
                </div>
            )
        }
    </div>
</article>
