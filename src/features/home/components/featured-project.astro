---
import Button from "@shared/components/ui/button.astro";

interface Props {
    imageSrc: string;
    imageAlt: string;
    projectName: string;
    description: string;
    imageClasses?: string;
    link?: string;
}

const {
    imageSrc,
    imageAlt,
    projectName,
    description,
    imageClasses = "",
    link,
} = Astro.props;
---

<article class="flex flex-col gap-4 text-start text-zinc-600">
    <div
        class="bg-emerald-50/70 rounded-2xl flex items-center justify-center p-8 md:p-12 lg:p-16 overflow-hidden h-[320px] sm:h-[420px] md:h-[520px] lg:h-[600px]"
    >
        <img
            class={`max-h-full w-auto max-w-full object-contain ${imageClasses}`}
            loading="lazy"
            decoding="async"
            src={imageSrc}
            alt={imageAlt}
        />
    </div>

    <div>
        <p class="text-zinc-500">{projectName}</p>
        <h3 class="font-semibold text-lg md:text-xl">{description}</h3>
    </div>

    {link && (
        <div>
            <Button link={link} variant="outline">Leer más</Button>
        </div>
    )}
</article>

