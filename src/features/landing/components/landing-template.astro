---
import Layout from "@app/layouts/Layout.astro";
import ArticleLayout from "@shared/components/layout/article-layout.astro";
import BackLink from "@shared/components/ui/back-link.astro";
import PageHeader from "@shared/components/ui/page-header.astro";
import BulletList from "@shared/components/ui/bullet-list.astro";
import HighlightedSection from "@shared/components/ui/highlighted-section.astro";
import SectionHeader from "@shared/components/ui/section-header.astro";
import FaqItem from "@shared/components/ui/faq-item.astro";
import ArticleFooter from "@shared/components/ui/article-footer.astro";
import CardSection from "@shared/components/ui/card-section.astro";
import CardHeading from "@shared/components/ui/card-heading.astro";
import EyebrowLabel from "@shared/components/ui/eyebrow-label.astro";
import ArrowIcon from "@shared/components/ui/arrow-icon.astro";
import type { LandingPage } from "@features/landing/data";
import {
    serviceSchema,
    breadcrumbSchema,
    faqPageSchema,
    type JsonLd,
} from "@shared/seo/schema";

interface Props {
    page: LandingPage;
}

const { page } = Astro.props;
const pagePath = `/${page.slug}`;

const schema: JsonLd[] = [
    serviceSchema({
        name: page.serviceName,
        serviceType: page.serviceType,
        description: page.metaDescription,
        url: pagePath,
    }),
    breadcrumbSchema([
        { name: "Inicio", path: "/" },
        { name: page.label, path: pagePath },
    ]),
    faqPageSchema(page.faqs),
];
---

<Layout title={page.metaTitle} description={page.metaDescription} schema={schema}>
    <ArticleLayout>
        <BackLink href="/" label="Volver al inicio" />

        <PageHeader
            label={page.label}
            title={page.title}
            highlight={page.highlight}
            subtitle={page.subtitle}
            cta={{ label: "Agendemos un diagnóstico", href: "/contacto" }}
            timing={page.timing}
        />

        <div class="flex flex-col gap-6 md:gap-8 mb-20">
            {
                page.sections.map((section) => (
                    <CardSection>
                        <CardHeading>{section.title}</CardHeading>
                        {section.body && (
                            <p class="text-[15px] md:text-base leading-relaxed text-zinc-600 max-w-2xl">
                                {section.body}
                            </p>
                        )}
                        {section.items && <BulletList items={section.items} />}
                    </CardSection>
                ))
            }
        </div>

        <HighlightedSection label={page.outcomesLabel} title="Qué te llevas">
            <BulletList items={page.outcomes} tone="emerald" />
        </HighlightedSection>

        {
            page.faqs.length > 0 && (
                <section class="mb-20">
                    <SectionHeader
                        label="Preguntas frecuentes"
                        title="Lo que suelen preguntarnos"
                    />
                    <div class="flex flex-col gap-3">
                        {page.faqs.map((faq) => (
                            <FaqItem question={faq.q}>
                                <p class="mt-4 text-[15px] md:text-base leading-relaxed text-zinc-600">
                                    {faq.a}
                                </p>
                            </FaqItem>
                        ))}
                    </div>
                </section>
            )
        }

        {
            page.related.length > 0 && (
                <section class="mb-20">
                    <SectionHeader
                        label="Sigue explorando"
                        title="Cómo encaja en lo que hacemos"
                    />
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
                        {page.related.map((item) => (
                            <a
                                href={item.href}
                                class="group rounded-2xl md:rounded-3xl border border-zinc-200 bg-emerald-50 p-8 md:p-10 transition-transform duration-200 hover:-translate-y-1 hover:border-emerald-700/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
                            >
                                <EyebrowLabel tone="emerald-soft">
                                    SYNC Estudio
                                </EyebrowLabel>
                                <CardHeading as="h3" class="mt-3">
                                    {item.label}
                                </CardHeading>
                                <p class="mt-3 text-[15px] leading-relaxed text-zinc-600">
                                    {item.description}
                                </p>
                                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-emerald-800 group-hover:gap-2.5 transition-all">
                                    Ver más
                                    <ArrowIcon />
                                </span>
                            </a>
                        ))}
                    </div>
                </section>
            )
        }

        <ArticleFooter
            primary={{ label: "Agendemos un diagnóstico", href: "/contacto" }}
            secondary={{ label: "Ver todas las soluciones", href: "/#soluciones" }}
        />
    </ArticleLayout>
</Layout>
