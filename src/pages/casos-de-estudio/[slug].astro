---
import "@app/styles/global.css";
import Layout from "@app/layouts/Layout.astro";
import ArticleLayout from "@shared/components/layout/article-layout.astro";
import BackLink from "@shared/components/ui/back-link.astro";
import ArticleFooter from "@shared/components/ui/article-footer.astro";
import { getEntry, render } from "astro:content";
import {
    articleSchema,
    breadcrumbSchema,
    type JsonLd,
} from "@shared/seo/schema";

const slug = Astro.params.slug;

if (!slug) {
    return new Response(null, { status: 404, statusText: "Not found" });
}

const entry = await getEntry("blog", slug);

if (!entry) {
    return new Response(null, { status: 404, statusText: "Not found" });
}

const { Content } = await render(entry);

const pagePath = `/casos-de-estudio/${slug}`;
const metaDescription =
    entry.data.description ??
    "Caso de estudio Sync Estudio — software e IA a medida para empresas en operación en México.";
const schema: JsonLd[] = [
    articleSchema({
        title: entry.data.title,
        description: metaDescription,
        url: pagePath,
        datePublished: entry.data.pubDate.toISOString(),
        image: entry.data.cover ?? undefined,
    }),
    breadcrumbSchema([
        { name: "Inicio", path: "/" },
        { name: "Casos de estudio", path: "/#proyectos" },
        { name: entry.data.title, path: pagePath },
    ]),
];
---

<Layout
    title={`${entry.data.title} | Caso de estudio en México | Sync Estudio`}
    description={metaDescription}
    schema={schema}
>
    <ArticleLayout maxWidth="2xl">
        <BackLink href="/#proyectos" label="Volver a proyectos" />

        <header class="mb-12 border-b border-zinc-200 pb-12">
            <div class="flex items-center gap-3 mb-6">
                <span class="text-xs tracking-wide font-medium text-zinc-500">
                    Caso de estudio
                </span>
                <span class="text-zinc-300" aria-hidden="true">•</span>
                <time
                    datetime={entry.data.pubDate.toISOString()}
                    class="text-sm text-zinc-500"
                >
                    {entry.data.pubDate.toLocaleDateString("es-ES", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })}
                </time>
            </div>

            <h1
                class="text-balance font-semibold leading-[1.05] tracking-[-0.02em] text-zinc-900"
                style="font-size: clamp(30px, 6vw, 60px);"
            >
                {entry.data.title}
            </h1>

            {entry.data.description && (
                <p class="mt-8 text-lg md:text-xl leading-relaxed text-zinc-600">
                    {entry.data.description}
                </p>
            )}
        </header>

        {entry.data.cover && (
            <figure class="mb-12 md:mb-16">
                <img
                    src={entry.data.cover}
                    alt={entry.data.title}
                    loading="eager"
                    decoding="async"
                    class="w-full h-auto rounded-2xl md:rounded-3xl border border-zinc-200/70"
                />
            </figure>
        )}

        <section class="prose prose-zinc case-study-prose max-w-none">
            <Content />
        </section>

        <ArticleFooter
            primary={{ label: "Agendemos un diagnóstico", href: "/contacto" }}
            secondary={{ label: "Volver al inicio", href: "/" }}
            spacingTop="large"
        />
    </ArticleLayout>
</Layout>
