---
import "@app/styles/global.css";
import Layout from "@app/layouts/Layout.astro";
import Button from "@shared/components/ui/button.astro";
import { getEntry, render } from "astro:content";

const slug = Astro.params.slug;

if (!slug) {
    return new Response(null, { status: 404, statusText: "Not found" });
}

const entry = await getEntry("blog", slug);

if (!entry) {
    return new Response(null, { status: 404, statusText: "Not found" });
}

const { Content } = await render(entry);
---

<Layout
    title={`${entry.data.title} | Sync Estudio`}
    description={entry.data.description ?? "Caso de estudio Sync Estudio — software e IA a medida para empresas en operación."}
>
    <article class="min-h-screen container mx-auto pt-32 pb-16 md:pt-40 md:pb-24">
        <div class="mx-auto w-full max-w-2xl">
            <nav class="mb-12">
                <a
                    href="/#projects"
                    class="group inline-flex items-center gap-2 text-sm font-medium text-zinc-500 transition-colors hover:text-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 rounded-full"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-transform group-hover:-translate-x-1"
                    >
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                    Volver a proyectos
                </a>
            </nav>

            <header class="mb-12 border-b border-zinc-200 pb-12">
                <div class="flex items-center gap-3 mb-6">
                    <span class="text-xs tracking-wide font-medium text-zinc-500">
                        Caso de estudio
                    </span>
                    <span class="text-zinc-300" aria-hidden="true">•</span>
                    <time
                        datetime={entry.data.pubDate.toISOString()}
                        class="text-sm text-zinc-500"
                    >
                        {entry.data.pubDate.toLocaleDateString("es-ES", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })}
                    </time>
                </div>

                <h1
                    class="text-balance font-semibold leading-[1.05] tracking-[-0.02em] text-zinc-900"
                    style="font-size: clamp(30px, 6vw, 60px);"
                >
                    {entry.data.title}
                </h1>

                {entry.data.description && (
                    <p class="mt-8 text-lg md:text-xl leading-relaxed text-zinc-600">
                        {entry.data.description}
                    </p>
                )}
            </header>

            <section class="prose prose-zinc case-study-prose max-w-none">
                <Content />
            </section>

            <footer class="mt-24 border-t border-zinc-200 pt-16 flex flex-wrap justify-center gap-3">
                <Button variant="default" link="/contacto">
                    Agendemos un diagnóstico
                </Button>
                <Button variant="outline" link="/">
                    Volver al inicio
                </Button>
            </footer>
        </div>
    </article>
</Layout>
