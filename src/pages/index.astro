---
export const prerender = true;

import "@app/styles/global.css";
import Layout from "@app/layouts/Layout.astro";
import Hero from "@features/home/components/hero.astro";
import Methodology from "@features/home/components/methodology.astro";
import Featured from "@features/home/components/featured.astro";
import Offerings from "@features/home/components/offerings.astro";
import About from "@features/home/components/about.astro";
import Faq from "@features/home/components/faq.astro";
---

<Layout routeKey="home">
	<div class="min-h-screen">
		<Hero />
		<About />
		<Methodology />
		<Offerings />
		<Featured />
		<Faq />
	</div>
</Layout>
