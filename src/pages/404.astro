---
import Layout from "@app/layouts/Layout.astro";
import Button from "@shared/components/ui/button.astro";
---

<Layout
    title="Página no encontrada | Sync Estudio"
    description="La ruta que buscas no existe o fue movida. Vuelve al inicio o escríbenos."
>
    <section class="min-h-screen flex flex-col items-center pt-28 pb-12 md:pt-32 md:pb-16 px-5 sm:px-6 md:px-8 lg:px-16 xl:px-24">
        <div class="w-full flex justify-center">
            <section
                class="relative overflow-hidden rounded-2xl md:rounded-3xl border border-zinc-200 bg-white px-6 sm:px-10 md:px-14 lg:px-20 py-10 md:py-12 w-full max-w-3xl"
            >
                <div
                    class="pointer-events-none absolute inset-0"
                    style="background-image: radial-gradient(circle, rgba(4,120,87,0.7) 1.2px, transparent 1.6px); background-size: 18px 18px; opacity: 0.4; mask-image: radial-gradient(ellipse at top right, black, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at top right, black, transparent 70%);"
                >
                </div>

                <div class="relative z-10 flex flex-col items-center text-center gap-8 md:gap-10" >
                    <p
                        class="text-xs tracking-[0.2em] uppercase font-medium text-zinc-500"
                    >
                        Error 404
                    </p>

                    <h1
                        class="font-semibold text-zinc-900 leading-[1.05] tracking-[-0.02em]"
                        style="font-size: clamp(30px, 6vw, 60px);"
                    >
                        Esta ruta no
                        <span
                            class="font-[IBM_Plex_Serif] italic font-medium bg-emerald-200/60 inline-block -rotate-1 px-1.5"
                            >existe</span
                        >.
                    </h1>

                    <p
                        class="text-zinc-600 max-w-xl"
                        style="font-size: clamp(16px, 1.8vw, 18px); line-height: 1.55;"
                    >
                        La página que buscas fue movida, renombrada o nunca
                        existió. Vuelve al inicio o cuéntanos qué necesitabas
                        encontrar.
                    </p>

                    <div class="flex flex-wrap items-center justify-center gap-3">
                        <Button variant="default" link="/">Volver al inicio</Button>
                        <Button variant="outline" link="/contacto">Escríbenos</Button>
                    </div>
                </div>
            </section>
        </div>
    </section>
</Layout>
