---
import SolutionPage from "@features/solutions/components/solution-page.astro";
import { getSolutions, type Solution } from "@features/solutions/data";

export const prerender = true;

export async function getStaticPaths() {
    return getSolutions("en").map((solution) => ({
        params: { slug: solution.slug },
        props: { solution },
    }));
}

type Props = { solution: Solution };

const { solution } = Astro.props;
---

<SolutionPage solution={solution} lang="en" />
