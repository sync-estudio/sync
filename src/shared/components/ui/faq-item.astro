---
interface Props {
    question: string;
}

const { question } = Astro.props;
---

<details
    class="group rounded-2xl border border-zinc-200 bg-white p-6 md:p-7 transition-colors hover:border-emerald-700/30 open:border-emerald-700/30"
>
    <summary
        class="flex items-center justify-between gap-4 cursor-pointer list-none text-base md:text-lg font-medium text-zinc-900"
    >
        <span>{question}</span>
        <span
            aria-hidden="true"
            class="text-emerald-700 text-xl transition-transform group-open:rotate-45"
        >
            +
        </span>
    </summary>
    <slot />
</details>

<style>
    details > summary::-webkit-details-marker {
        display: none;
    }
</style>
