---
import Button from "@shared/components/ui/button.astro";

interface Props {
    primary: { label: string; href: string };
    secondary?: { label: string; href: string };
    spacingTop?: "default" | "large";
}

const { primary, secondary, spacingTop = "default" } = Astro.props;

const topClass = spacingTop === "large" ? "mt-24" : "";
---

<footer
    class={`${topClass} border-t border-zinc-200 pt-16 flex flex-wrap justify-center gap-3`}
>
    <Button variant="default" link={primary.href}>{primary.label}</Button>
    {
        secondary && (
            <Button variant="outline" link={secondary.href}>
                {secondary.label}
            </Button>
        )
    }
</footer>
