---
interface Props {
    variant?: "default" | "outline" | "ghost"
    style?: string,
    link?: string,
    blank?: boolean
}

const { variant = "default", style = "", link, blank = false } = Astro.props

const variants = {
    default: "inline-flex items-center justify-center text-center cursor-pointer px-4 sm:px-6 md:px-8 py-2.5 sm:py-3 md:py-4 text-xs sm:text-sm md:text-base bg-zinc-800 text-white rounded-full transition-all duration-200 ease-in-out hover:bg-zinc-700 hover:scale-[1.02] hover:shadow-md active:scale-[0.98] active:bg-zinc-900 focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white",
    outline: "group inline-flex items-center justify-center gap-2 cursor-pointer px-5 py-2.5 text-sm font-semibold text-current bg-transparent border border-current/25 rounded-full transition-colors duration-200 ease-in-out hover:bg-current/10 active:bg-current/15 focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2",
    ghost: "inline-flex items-center justify-center text-center cursor-pointer px-3 sm:px-4 md:px-4 py-2.5 sm:py-3 md:py-4 text-xs sm:text-sm md:text-sm text-gray-700 rounded-full transition-all duration-200 ease-in-out hover:bg-gray-100 hover:text-gray-900 hover:scale-[1.02] active:scale-[0.98] active:bg-gray-200 focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white"
}
---

{link ? (
    <a href={link} class={`${style} ${variants[variant]}`} target={blank ? "_blank" : "_self"}>
        <slot />
    </a>
) : (
    <button class={`${style} ${variants[variant]}`}>
        <slot />
    </button>
)}