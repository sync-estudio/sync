---
interface Props {
    variant?: "default" | "outline" | "ghost" | "small";
    style?: string;
    link?: string;
    blank?: boolean;
    disabled?: boolean;
}

const {
    variant = "default",
    style = "",
    link,
    blank = false,
    disabled = false,
} = Astro.props;

const disabledClass = "disabled:opacity-50 disabled:cursor-not-allowed";

const variants = {
    default:
        "group inline-flex items-center justify-center gap-2 cursor-pointer px-5 py-2.5 text-sm font-semibold bg-zinc-800 text-white border border-transparent rounded-full shadow-sm transition-colors duration-200 ease-in-out hover:bg-zinc-700 active:bg-zinc-900 focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2",
    outline:
        "group inline-flex items-center justify-center gap-2 cursor-pointer px-5 py-2.5 text-sm font-semibold text-zinc-800 bg-white/70 backdrop-blur-md border border-zinc-300/80 rounded-full shadow-sm transition-colors duration-200 ease-in-out hover:bg-white/90 active:bg-white focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2",
    small:
        "group inline-flex items-center justify-center gap-1.5 cursor-pointer px-3.5 py-1.5 text-xs font-semibold text-current bg-transparent border border-current/25 rounded-full transition-colors duration-200 ease-in-out hover:bg-current/10 active:bg-current/15 focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2",
    ghost:
        "inline-flex items-center justify-center text-center cursor-pointer px-3 sm:px-4 md:px-4 py-2.5 sm:py-3 md:py-4 text-xs sm:text-sm md:text-sm text-gray-700 rounded-full transition-all duration-200 ease-in-out hover:bg-gray-100 hover:text-gray-900 hover:scale-[1.02] active:scale-[0.98] active:bg-gray-200 focus:outline-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white",
};
---

{
    link ? (
        <a
            href={link}
            class={`${style} ${variants[variant]}`}
            target={blank ? "_blank" : "_self"}
        >
            <slot />
        </a>
    ) : (
        <button
            class={`${style} ${variants[variant]} ${disabledClass}`}
            disabled={disabled}
        >
            <slot />
        </button>
    )
}
