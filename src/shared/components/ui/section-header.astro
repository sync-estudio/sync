---
import EyebrowLabel from "@shared/components/ui/eyebrow-label.astro";

interface Props {
    label: string;
    title: string;
    labelTone?: "zinc" | "emerald";
}

const { label, title, labelTone = "zinc" } = Astro.props;
---

<header data-reveal class="mb-8 flex flex-col gap-3">
    <EyebrowLabel tone={labelTone}>{label}</EyebrowLabel>
    <h2
        class="text-2xl md:text-3xl font-semibold tracking-tight text-zinc-900"
    >
        {title}
    </h2>
</header>
