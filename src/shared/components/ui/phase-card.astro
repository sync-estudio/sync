---
import BulletList from "@shared/components/ui/bullet-list.astro";
import CardSection from "@shared/components/ui/card-section.astro";
import CardHeading from "@shared/components/ui/card-heading.astro";

interface Props {
    number: string;
    title: string;
    timing?: string;
    body?: string;
    items?: string[];
}

const { number, title, timing, body, items } = Astro.props;
---

<CardSection>
    <div class="flex items-center gap-4">
        <span
            class="inline-flex h-11 w-11 md:h-12 md:w-12 items-center justify-center rounded-full bg-emerald-50 border border-emerald-200/60 font-[ibm-plex-serif] italic font-bold text-emerald-900 text-base md:text-lg"
        >
            {number}
        </span>
        <div class="flex flex-col gap-1">
            <CardHeading>{title}</CardHeading>
            {
                timing && (
                    <span class="text-xs md:text-sm text-emerald-800 font-medium">
                        {timing}
                    </span>
                )
            }
        </div>
    </div>
    {
        body && (
            <p class="text-[15px] md:text-base leading-relaxed text-zinc-600 max-w-2xl">
                {body}
            </p>
        )
    }
    {items && items.length > 0 && <BulletList items={items} />}
</CardSection>
