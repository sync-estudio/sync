---
interface Props {
    direction?: "left" | "right";
    size?: number;
    class?: string;
}

const { direction = "right", size = 16, class: extra = "" } = Astro.props;

const path = direction === "left" ? "m15 18-6-6 6-6" : "m9 18 6-6-6-6";
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={extra}
>
    <path d={path}></path>
</svg>
