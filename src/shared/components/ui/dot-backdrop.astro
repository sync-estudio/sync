---
interface Props {
    /** Half-width of the centered reading column the dots are masked around. */
    colHalf?: string;
    class?: string;
}

const { colHalf = "28rem", class: extra = "" } = Astro.props;
---

<div
    class:list={["dot-backdrop", extra]}
    style={`--col-half: ${colHalf};`}
    aria-hidden="true"
>
</div>

<style>
    /* Emerald dot texture in the page gutters only. Fixed full-bleed layer,
       masked transparent across the centered reading column so it never sits
       behind copy. On narrow screens the column fills the viewport, the gutter
       collapses to zero and the pattern disappears. */
    .dot-backdrop {
        position: fixed;
        inset: 0;
        z-index: -10;
        pointer-events: none;
        background-image: radial-gradient(
            circle,
            rgba(4, 120, 87, 0.16) 1px,
            transparent 1.4px
        );
        background-size: 18px 18px;
        background-position: center;
        mask-image:
            linear-gradient(
                to right,
                #000 0,
                #000 calc(50% - var(--col-half) - 2rem),
                transparent calc(50% - var(--col-half) + 1.5rem),
                transparent calc(50% + var(--col-half) - 1.5rem),
                #000 calc(50% + var(--col-half) + 2rem),
                #000 100%
            ),
            linear-gradient(
                to bottom,
                transparent 0,
                #000 12%,
                #000 88%,
                transparent 100%
            );
        -webkit-mask-image:
            linear-gradient(
                to right,
                #000 0,
                #000 calc(50% - var(--col-half) - 2rem),
                transparent calc(50% - var(--col-half) + 1.5rem),
                transparent calc(50% + var(--col-half) - 1.5rem),
                #000 calc(50% + var(--col-half) + 2rem),
                #000 100%
            ),
            linear-gradient(
                to bottom,
                transparent 0,
                #000 12%,
                #000 88%,
                transparent 100%
            );
        mask-composite: intersect;
        -webkit-mask-composite: source-in;
    }

    @media (max-width: 767px) {
        .dot-backdrop {
            display: none;
        }
    }
</style>
