---
import CardHeading from "@shared/components/ui/card-heading.astro";
import EyebrowLabel from "@shared/components/ui/eyebrow-label.astro";

interface Props {
    label: string;
    title: string;
}

const { label, title } = Astro.props;
---

<section
    class="mb-20 rounded-2xl md:rounded-3xl bg-[#defbed] p-8 md:p-10 flex flex-col gap-5"
>
    <EyebrowLabel tone="emerald-soft">{label}</EyebrowLabel>
    <CardHeading>{title}</CardHeading>
    <slot />
</section>
