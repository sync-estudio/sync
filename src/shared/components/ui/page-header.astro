---
import Button from "@shared/components/ui/button.astro";
import HighlightBadge from "@shared/components/ui/highlight-badge.astro";
import EyebrowLabel from "@shared/components/ui/eyebrow-label.astro";

interface Props {
    label: string;
    title: string;
    highlight?: string;
    subtitle?: string;
    cta?: { label: string; href: string };
    timing?: string;
    timingPosition?: "top" | "bottom";
    helper?: string;
}

const {
    label,
    title,
    highlight,
    subtitle,
    cta,
    timing,
    timingPosition = "bottom",
    helper,
} = Astro.props;

const hasHighlight = Boolean(highlight) && title.includes(highlight ?? "");
const parts = hasHighlight ? title.split(highlight as string) : [title];
---

<header
    class="mb-16 border-b border-zinc-200 pb-12 flex flex-col items-center text-center gap-6 max-w-3xl mx-auto"
>
    <EyebrowLabel>{label}</EyebrowLabel>

    <h1
        class="text-balance font-semibold leading-[1.05] tracking-[-0.02em] text-zinc-900"
        style="font-size: clamp(30px, 6vw, 60px);"
    >
        {
            hasHighlight ? (
                <>
                    {parts[0]}
                    <HighlightBadge>{highlight}</HighlightBadge>
                    {parts[1]}
                </>
            ) : (
                title
            )
        }
    </h1>

    {
        subtitle && (
            <p class="text-lg md:text-xl leading-relaxed text-zinc-600 max-w-2xl">
                {subtitle}
            </p>
        )
    }

    {helper && <span class="text-sm text-zinc-500">{helper}</span>}

    {
        cta && (
            <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
                <Button variant="default" link={cta.href}>
                    {cta.label}
                </Button>
            </div>
        )
    }

    {
        timing && timingPosition === "bottom" && (
            <span class="text-sm text-zinc-500">{timing}</span>
        )
    }
</header>
