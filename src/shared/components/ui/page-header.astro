---
import Button from "@shared/components/ui/button.astro";
import HighlightBadge from "@shared/components/ui/highlight-badge.astro";
import EyebrowLabel from "@shared/components/ui/eyebrow-label.astro";

interface Props {
    label: string;
    title: string;
    highlight?: string;
    subtitle?: string;
    cta?: { label: string; href: string };
    timing?: string;
    timingPosition?: "top" | "bottom";
    helper?: string;
}

const {
    label,
    title,
    highlight,
    subtitle,
    cta,
    timing,
    timingPosition = "bottom",
    helper,
} = Astro.props;

const hasHighlight = Boolean(highlight) && title.includes(highlight ?? "");
const parts = hasHighlight ? title.split(highlight as string) : [title];
---

<header
    class="mb-16 md:mb-20 border-b border-zinc-200 pt-2 pb-14 md:pb-20"
>
    <div
        class="relative z-10 flex flex-col items-center text-center gap-6 max-w-3xl mx-auto"
    >
        <div data-reveal>
            <EyebrowLabel>{label}</EyebrowLabel>
        </div>

        <h1
            data-reveal
            data-reveal-delay="60"
            class="text-balance font-bold leading-[1.05] tracking-tight text-zinc-900 text-4xl sm:text-5xl md:text-6xl lg:text-7xl"
        >
            {
                hasHighlight ? (
                    <>
                        {parts[0]}
                        <HighlightBadge>{highlight}</HighlightBadge>
                        {parts[1]}
                    </>
                ) : (
                    title
                )
            }
        </h1>

        {
            subtitle && (
                <p
                    data-reveal
                    data-reveal-delay="120"
                    class="text-lg md:text-xl leading-relaxed text-zinc-600 max-w-2xl"
                >
                    {subtitle}
                </p>
            )
        }

        {
            helper && (
                <span
                    data-reveal
                    data-reveal-delay="160"
                    class="text-sm text-zinc-500"
                >
                    {helper}
                </span>
            )
        }

        {
            cta && (
                <div
                    data-reveal
                    data-reveal-delay="200"
                    class="mt-2 flex flex-wrap items-center justify-center gap-3"
                >
                    <Button variant="default" link={cta.href}>
                        {cta.label}
                    </Button>
                </div>
            )
        }

        {
            timing && timingPosition === "bottom" && (
                <span
                    data-reveal
                    data-reveal-delay="240"
                    class="text-sm text-zinc-500"
                >
                    {timing}
                </span>
            )
        }
    </div>
</header>
