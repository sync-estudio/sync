---
const linkBase =
    "text-zinc-400 hover:text-white transition-colors rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-900";
---

<footer class="container mx-auto py-8 md:py-12 mt-auto w-full">
    <div
        class="footer-card relative isolate overflow-hidden rounded-2xl md:rounded-3xl border border-zinc-800 bg-zinc-900 text-zinc-300"
    >
        <div class="footer-dots" aria-hidden="true"></div>

        <div class="relative z-10 px-6 sm:px-10 md:px-14 lg:px-20 py-12 md:py-16 flex flex-col gap-10 md:gap-14">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8">
                <div class="flex flex-col gap-4 max-w-md">
                    <a
                        href="/#inicio"
                        aria-label="Inicio"
                        class="inline-flex items-center self-start rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
                    >
                        <img
                            src="/sync_logo.svg"
                            alt="SYNC Estudio"
                            width="69"
                            height="19"
                            loading="lazy"
                            decoding="async"
                            class="h-5 w-auto invert brightness-0 contrast-200"
                        />
                    </a>
                    <p class="text-zinc-400 text-base md:text-lg leading-snug">
                        Construimos sistemas que sirven a tu operación. No operaciones que sirven al software.
                    </p>
                </div>

                <nav
                    class="flex flex-wrap gap-x-6 gap-y-2 text-sm md:text-base"
                    aria-label="Enlaces del sitio"
                >
                    <a href="/#proyectos" class={linkBase}>Proyectos</a>
                    <a href="/#nosotros" class={linkBase}>Nosotros</a>
                    <a href="/como-trabajamos" class={linkBase}>Metodología</a>
                    <a href="/#soluciones" class={linkBase}>Soluciones</a>
                    <a href="/como-cobramos" class={linkBase}>Cómo cobramos</a>
                    <a href="/#preguntas" class={linkBase}>Preguntas</a>
                    <a href="/contacto" class={linkBase}>Contacto</a>
                </nav>
            </div>

            <div
                class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 pt-6 border-t border-white/10"
            >
                <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-zinc-400">
                    <a href="mailto:sync@syncestudio.com" class={linkBase}
                        >sync@syncestudio.com</a
                    >
                    <a href="tel:+5222228230805" class={linkBase}>+52 222 2823 0805</a>
                    <span>Puebla, México</span>
                </div>

                <div class="flex items-center gap-4">
                    <a
                        href="https://www.instagram.com/sync.estudio/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram de SYNC Estudio"
                        class={`inline-flex w-9 h-9 items-center justify-center rounded-full border border-white/15 bg-white/5 hover:bg-white/10 ${linkBase}`}
                    >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href="https://www.linkedin.com/company/syncestudio/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="LinkedIn de SYNC Estudio"
                        class={`inline-flex w-9 h-9 items-center justify-center rounded-full border border-white/15 bg-white/5 hover:bg-white/10 ${linkBase}`}
                    >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.852 3.37-1.852 3.601 0 4.267 2.37 4.267 5.455v6.288zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                            ></path>
                        </svg>
                    </a>
                    <p class="text-zinc-500 text-xs">© 2026 SYNC Estudio.</p>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
    .footer-dots {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background-image: radial-gradient(
            circle,
            rgba(255, 255, 255, 0.18) 1.2px,
            transparent 1.6px
        );
        background-size: 14px 14px;
        background-position: bottom right;
        mask-image: radial-gradient(
            ellipse 90% 110% at bottom right,
            #000 0%,
            rgba(0, 0, 0, 0.55) 35%,
            rgba(0, 0, 0, 0.2) 70%,
            rgba(0, 0, 0, 0.08) 100%
        );
        -webkit-mask-image: radial-gradient(
            ellipse 90% 110% at bottom right,
            #000 0%,
            rgba(0, 0, 0, 0.55) 35%,
            rgba(0, 0, 0, 0.2) 70%,
            rgba(0, 0, 0, 0.08) 100%
        );
    }
</style>
