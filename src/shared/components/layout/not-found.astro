---
import Layout from "@app/layouts/Layout.astro";
import Button from "@shared/components/ui/button.astro";
import AsciiWave from "@shared/components/ui/ascii-wave.astro";
import { getLang, useTranslations, localizedPath } from "@i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout
    title={t("page.notFound.title")}
    description={t("page.notFound.description")}
>
    <section
        class="min-h-screen flex flex-col items-center justify-center pt-28 pb-12 md:pt-32 md:pb-16 px-5 sm:px-6 md:px-8 lg:px-16 xl:px-24"
    >
        <div class="w-full flex justify-center">
            <section
                class="relative isolate overflow-hidden rounded-2xl md:rounded-3xl px-6 sm:px-10 md:px-14 lg:px-20 py-12 md:py-16 w-full max-w-3xl"
            >
                <AsciiWave
                    color="rgba(4, 120, 87, 0.18)"
                    position="center"
                    intensity="soft"
                />
                <div
                    class="relative z-10 flex flex-col items-center text-center gap-8 md:gap-10"
                >
                    <p
                        class="text-xs tracking-[0.2em] uppercase font-medium text-zinc-500"
                    >
                        {t("notfound.eyebrow")}
                    </p>

                    <h1
                        class="font-bold text-zinc-900 leading-[1.05] tracking-tight text-4xl sm:text-5xl md:text-6xl lg:text-7xl"
                    >
                        {t("notfound.titleLead")}
                        <span class="text-emerald-700">{t("notfound.titleHighlight")}</span>{t("notfound.titleTail")}
                    </h1>

                    <p
                        class="text-zinc-600 max-w-xl text-base md:text-lg leading-relaxed"
                    >
                        {t("notfound.body")}
                    </p>

                    <div
                        class="flex flex-wrap items-center justify-center gap-3"
                    >
                        <Button variant="default" link={localizedPath("home", lang)}
                            >{t("notfound.ctaPrimary")}</Button
                        >
                        <Button variant="outline" link={localizedPath("contact", lang)}
                            >{t("notfound.ctaSecondary")}</Button
                        >
                    </div>
                </div>
            </section>
        </div>
    </section>
</Layout>
