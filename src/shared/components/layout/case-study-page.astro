---
import "@app/styles/global.css";
import { Image } from "astro:assets";
import Layout from "@app/layouts/Layout.astro";
import ArticleLayout from "@shared/components/layout/article-layout.astro";
import BackLink from "@shared/components/ui/back-link.astro";
import ArticleFooter from "@shared/components/ui/article-footer.astro";
import { render, type CollectionEntry } from "astro:content";
import {
    articleSchema,
    breadcrumbSchema,
    type JsonLd,
} from "@shared/seo/schema";
import {
    useTranslations,
    localizedPath,
    homeHash,
    caseStudyPath,
    type Lang,
} from "@i18n/utils";

interface Props {
    entry: CollectionEntry<"blog">;
    lang: Lang;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);

const slug = entry.data.urlSlug ?? entry.id;
const pagePath = caseStudyPath(slug, lang);
const projectsHash = homeHash("#proyectos", lang);
const metaDescription = entry.data.description ?? t("case.fallbackDescription");
const dateLocale = lang === "en" ? "en-US" : "es-ES";

const alternates: Record<Lang, string> = {
    es: caseStudyPath(slug, "es"),
    en: caseStudyPath(slug, "en"),
};

const schema: JsonLd[] = [
    articleSchema({
        title: entry.data.title,
        description: metaDescription,
        url: pagePath,
        lang,
        datePublished: entry.data.pubDate.toISOString(),
        image: entry.data.cover?.src ?? undefined,
    }),
    breadcrumbSchema([
        { name: t("breadcrumb.home"), path: localizedPath("home", lang) },
        { name: t("breadcrumb.caseStudies"), path: projectsHash },
        { name: entry.data.title, path: pagePath },
    ]),
];
---

<Layout
    title={`${entry.data.title} | ${t("case.titleSuffix")}`}
    description={metaDescription}
    schema={schema}
    alternates={alternates}
>
    <ArticleLayout maxWidth="2xl">
        <BackLink href={projectsHash} label={t("case.back")} />

        <header class="mb-12 border-b border-zinc-200 pb-12">
            <div class="flex items-center gap-3 mb-6">
                <span class="text-xs tracking-wide font-medium text-zinc-500">
                    {t("case.label")}
                </span>
                <span class="text-zinc-300" aria-hidden="true">•</span>
                <time
                    datetime={entry.data.pubDate.toISOString()}
                    class="text-sm text-zinc-500"
                >
                    {entry.data.pubDate.toLocaleDateString(dateLocale, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })}
                </time>
            </div>

            <h1
                class="text-balance font-semibold leading-[1.05] tracking-[-0.02em] text-zinc-900"
                style="font-size: clamp(30px, 6vw, 60px);"
            >
                {entry.data.title}
            </h1>

            {entry.data.description && (
                <p class="mt-8 text-lg md:text-xl leading-relaxed text-zinc-600">
                    {entry.data.description}
                </p>
            )}
        </header>

        {entry.data.cover && (
            <figure class="mb-12 md:mb-16">
                <Image
                    src={entry.data.cover}
                    alt={entry.data.title}
                    loading="eager"
                    decoding="async"
                    format="webp"
                    quality={80}
                    class="w-full h-auto rounded-2xl md:rounded-3xl border border-zinc-200/70"
                />
            </figure>
        )}

        <section class="prose prose-zinc case-study-prose max-w-none">
            <Content />
        </section>

        <ArticleFooter
            primary={{ label: t("case.ctaPrimary"), href: localizedPath("contact", lang) }}
            secondary={{ label: t("case.ctaSecondary"), href: localizedPath("home", lang) }}
            spacingTop="large"
        />
    </ArticleLayout>
</Layout>
