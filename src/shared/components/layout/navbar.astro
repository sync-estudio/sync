---
const linkWrapper =
    "text-zinc-600 hover:text-zinc-900 px-3 py-1.5 rounded-full transition-all duration-300 hover:bg-zinc-100/80 font-medium text-sm md:text-base focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 focus-visible:ring-offset-white";

const ctaWrapper =
    "bg-zinc-900 text-white hover:bg-zinc-800 px-5 py-1.5 rounded-full transition-all duration-300 font-medium text-sm md:text-base shadow-sm hover:shadow-md active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white";

const logoWrapper =
    "flex items-center transition-transform hover:scale-105 active:scale-95";
---

<nav
    data-site-nav
    class="nav-root fixed inset-x-0 flex justify-center z-50 pointer-events-none"
>
    <div class="flex w-full flex-col items-center gap-3 relative">
        <div
            data-nav-pill
            class="navbar-pill px-4 md:px-6 grid grid-cols-[auto_1fr_auto] items-center gap-3 md:gap-6 pointer-events-auto w-[95%] max-w-5xl navbar-entrance"
        >
            <div class="flex items-center shrink-0">
                <a class={logoWrapper} href="/#hero" aria-label="Inicio">
                    <img
                        src="/sync.svg"
                        alt="SYNC Estudio"
                        width="717"
                        height="186"
                        class="h-3 w-auto md:h-4 object-contain"
                    />
                </a>
            </div>

            <div class="hidden sm:flex justify-center">
                <ul
                    class="flex items-center gap-0.5 md:gap-1 overflow-x-auto no-scrollbar"
                    role="menubar"
                    aria-label="Navegación principal"
                >
                    <li class="relative">
                        <a class={linkWrapper} href="/#hero" role="menuitem"
                            >Inicio</a
                        >
                    </li>
                    <li class="relative">
                        <a class={linkWrapper} href="/#projects" role="menuitem"
                            >Proyectos</a
                        >
                    </li>
                    <li class="relative">
                        <a class={linkWrapper} href="/#about" role="menuitem"
                            >Nosotros</a
                        >
                    </li>
                    <li class="relative">
                        <a class={linkWrapper} href="/como-trabajamos" role="menuitem"
                            >Metodología</a
                        >
                    </li>
                    <li class="relative">
                        <a class={linkWrapper} href="/#soluciones" role="menuitem"
                            >Soluciones</a
                        >
                    </li>
                </ul>
            </div>

            <div class="flex items-center justify-end shrink-0 gap-2">
                <a
                    class={`${ctaWrapper} hidden sm:inline-flex`}
                    href="/contacto"
                    role="menuitem">Trabajemos juntos</a
                >
                <button
                    type="button"
                    class="sm:hidden inline-flex items-center justify-center h-10 w-10 rounded-full border border-white/50 bg-white/80 text-zinc-800 shadow-sm transition-all duration-300 hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 focus-visible:ring-offset-white nav-toggle"
                    aria-label="Abrir menú"
                    aria-controls="mobile-nav-menu"
                    aria-expanded="false"
                    data-site-nav-toggle
                >
                    <span class="flex flex-col gap-1 nav-toggle-bars">
                        <span
                            class="block h-0.5 w-4 bg-zinc-800 rounded-full nav-toggle-bar nav-toggle-bar-top"
                        ></span>
                        <span
                            class="block h-0.5 w-4 bg-zinc-800 rounded-full nav-toggle-bar nav-toggle-bar-mid"
                        ></span>
                        <span
                            class="block h-0.5 w-4 bg-zinc-800 rounded-full nav-toggle-bar nav-toggle-bar-bottom"
                        ></span>
                    </span>
                </button>
            </div>
        </div>

        <div
            class="sm:hidden absolute inset-x-0 top-full mt-3 flex justify-center pointer-events-auto"
        >
            <div
                id="mobile-nav-menu"
                class="mobile-menu w-[95%] max-w-sm bg-white/80 backdrop-blur-lg border border-white/50 shadow-[0_12px_32px_rgba(0,0,0,0.08)] rounded-2xl px-3 py-3"
                data-site-nav-menu
                aria-hidden="true"
                inert
            >
                <ul
                    class="flex flex-col gap-2"
                    role="menu"
                    aria-label="Navegación móvil"
                >
                    <li>
                        <a
                            class="block w-full text-zinc-700 hover:text-zinc-900 px-3 py-2 rounded-xl transition-all duration-200 hover:bg-zinc-100/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
                            href="/#hero"
                            role="menuitem">Inicio</a
                        >
                    </li>
                    <li>
                        <a
                            class="block w-full text-zinc-700 hover:text-zinc-900 px-3 py-2 rounded-xl transition-all duration-200 hover:bg-zinc-100/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
                            href="/#projects"
                            role="menuitem">Proyectos</a
                        >
                    </li>
                    <li>
                        <a
                            class="block w-full text-zinc-700 hover:text-zinc-900 px-3 py-2 rounded-xl transition-all duration-200 hover:bg-zinc-100/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
                            href="/#about"
                            role="menuitem">Nosotros</a
                        >
                    </li>
                    <li>
                        <a
                            class="block w-full text-zinc-700 hover:text-zinc-900 px-3 py-2 rounded-xl transition-all duration-200 hover:bg-zinc-100/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
                            href="/como-trabajamos"
                            role="menuitem">Metodología</a
                        >
                    </li>
                    <li>
                        <a
                            class="block w-full text-zinc-700 hover:text-zinc-900 px-3 py-2 rounded-xl transition-all duration-200 hover:bg-zinc-100/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
                            href="/#soluciones"
                            role="menuitem">Soluciones</a
                        >
                    </li>
                    <li>
                        <a
                            class="block w-full text-zinc-900 font-medium px-3 py-2 rounded-xl bg-zinc-100/90 hover:bg-zinc-200/80 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
                            href="/contacto"
                            role="menuitem">Trabajemos juntos</a
                        >
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<style>
    .nav-root {
        top: 0;
        transition: top 280ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .nav-root.is-scrolled {
        top: 1rem;
    }

    .navbar-pill {
        background-color: transparent;
        border: 1px solid transparent;
        border-radius: 9999px;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        padding-top: 1.25rem;
        padding-bottom: 1.25rem;
        transition:
            background-color 280ms ease,
            border-color 280ms ease,
            box-shadow 280ms ease,
            backdrop-filter 280ms ease,
            padding 280ms ease;
    }

    @media (min-width: 768px) {
        .navbar-pill {
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
        }
    }

    .navbar-pill.is-scrolled {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
    }

    .navbar-pill.is-scrolled {
        background-color: rgba(255, 255, 255, 0.7);
        border-color: rgba(255, 255, 255, 0.4);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    .navbar-entrance {
        opacity: 0;
        transform: translateY(-10px);
        will-change: opacity, transform;
    }

    .mobile-menu {
        max-height: 0;
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
        overflow: hidden;
        pointer-events: none;
        will-change: opacity, transform, max-height;
    }

    .mobile-menu.is-open {
        pointer-events: auto;
    }

    .nav-toggle-bar {
        transition:
            transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
            opacity 180ms ease-out;
        transform-origin: center;
    }

    .nav-toggle.is-open .nav-toggle-bar-top {
        transform: translateY(6px) rotate(45deg);
    }

    .nav-toggle.is-open .nav-toggle-bar-mid {
        opacity: 0;
    }

    .nav-toggle.is-open .nav-toggle-bar-bottom {
        transform: translateY(-6px) rotate(-45deg);
    }

    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .navbar-entrance,
        .mobile-menu.is-open {
            opacity: 1 !important;
            transform: none !important;
            max-height: none !important;
        }

        .nav-toggle-bar {
            transition: none;
        }
    }
</style>

<script>
    import { animate } from "framer-motion";

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    ).matches;

    const nav = document.querySelector("[data-site-nav]");
    const pill = nav?.querySelector<HTMLElement>("[data-nav-pill]");
    const entrance = nav?.querySelector<HTMLElement>(".navbar-entrance");
    const toggle = nav?.querySelector("[data-site-nav-toggle]");
    const menu = nav?.querySelector("[data-site-nav-menu]");

    if (nav instanceof HTMLElement && pill instanceof HTMLElement) {
        const SCROLL_THRESHOLD = 8;
        const applyScrollState = () => {
            const scrolled = window.scrollY > SCROLL_THRESHOLD;
            nav.classList.toggle("is-scrolled", scrolled);
            pill.classList.toggle("is-scrolled", scrolled);
        };
        applyScrollState();
        window.addEventListener("scroll", applyScrollState, { passive: true });
    }

    if (entrance) {
        if (prefersReducedMotion) {
            entrance.style.opacity = "1";
            entrance.style.transform = "none";
        } else {
            animate(
                entrance,
                { opacity: [0, 1], transform: ["translateY(-10px)", "translateY(0px)"] },
                { duration: 0.6, ease: [0.22, 1, 0.36, 1], delay: 0.4 }
            );
        }
    }

    if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
        const EASE = [0.22, 1, 0.36, 1] as const;

        const animateMenuOpen = () => {
            if (prefersReducedMotion) {
                menu.style.opacity = "1";
                menu.style.transform = "none";
                menu.style.maxHeight = "none";
                return;
            }
            animate(
                menu,
                {
                    opacity: [0, 1],
                    transform: [
                        "translateY(-8px) scale(0.98)",
                        "translateY(0px) scale(1)",
                    ],
                    maxHeight: ["0px", "360px"],
                },
                { duration: 0.28, ease: EASE }
            );
        };

        const animateMenuClose = () => {
            if (prefersReducedMotion) {
                menu.style.opacity = "0";
                menu.style.transform = "translateY(-8px) scale(0.98)";
                menu.style.maxHeight = "0px";
                return;
            }
            animate(
                menu,
                {
                    opacity: [1, 0],
                    transform: [
                        "translateY(0px) scale(1)",
                        "translateY(-8px) scale(0.98)",
                    ],
                    maxHeight: ["360px", "0px"],
                },
                { duration: 0.22, ease: EASE }
            );
        };

        const setMenuState = (isOpen: boolean) => {
            const wasOpen = menu.classList.contains("is-open");
            menu.classList.toggle("is-open", isOpen);
            toggle.setAttribute("aria-expanded", String(isOpen));
            menu.setAttribute("aria-hidden", String(!isOpen));
            toggle.classList.toggle("is-open", isOpen);
            toggle.setAttribute(
                "aria-label",
                isOpen ? "Cerrar menú" : "Abrir menú",
            );

            if (isOpen) {
                menu.removeAttribute("inert");
                animateMenuOpen();
            } else {
                menu.setAttribute("inert", "");
                if (wasOpen) animateMenuClose();
            }
        };

        toggle.addEventListener("click", () => {
            const willOpen = !menu.classList.contains("is-open");
            setMenuState(willOpen);
        });

        menu.addEventListener("click", (event) => {
            const target = event.target;
            const link = target instanceof Element ? target.closest("a") : null;

            if (!(link instanceof HTMLAnchorElement)) {
                return;
            }

            setMenuState(false);
        });

        const mediaQuery = window.matchMedia("(min-width: 640px)");

        const syncMenuState = () => {
            if (mediaQuery.matches) {
                setMenuState(false);
            }
        };

        syncMenuState();
        mediaQuery.addEventListener("change", syncMenuState);
    }
</script>
