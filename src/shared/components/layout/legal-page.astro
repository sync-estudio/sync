---
import "@app/styles/global.css";
import type { LegalCopy } from "@i18n/content/legal";

interface Props {
    copy: LegalCopy;
}

const { copy } = Astro.props;
---

<article class="container mx-auto pt-28 md:pt-36 pb-16 md:pb-24">
    <div class="max-w-3xl mx-auto">
        <header class="mb-10 md:mb-14">
            <h1
                class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 text-balance"
            >
                {copy.title}
            </h1>
            <p class="mt-3 text-sm text-zinc-400">{copy.updated}</p>
            <p class="mt-6 text-base md:text-lg text-zinc-600 leading-relaxed">
                {copy.intro}
            </p>
        </header>

        <div class="flex flex-col gap-8 md:gap-10">
            {
                copy.sections.map((section) => (
                    <section>
                        <h2 class="text-xl md:text-2xl font-semibold tracking-tight text-zinc-900">
                            {section.heading}
                        </h2>
                        {section.paragraphs.map((p) => (
                            <p class="mt-3 text-base text-zinc-600 leading-relaxed">
                                {p}
                            </p>
                        ))}
                        {section.bullets && (
                            <ul class="mt-3 flex flex-col gap-2 list-disc pl-5 text-base text-zinc-600 leading-relaxed marker:text-emerald-700">
                                {section.bullets.map((b) => (
                                    <li>{b}</li>
                                ))}
                            </ul>
                        )}
                    </section>
                ))
            }
        </div>
    </div>
</article>
